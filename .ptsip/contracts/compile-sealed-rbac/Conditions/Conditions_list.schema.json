{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:rbac:conditions-list:schema:v1",
  "title": "PTSIP RBAC Conditions List Structural Contract",
  "$comment": "Structure only. No condition evaluation, NIST-to-PTSIP role equivalence, approval, or authority is implied. ID uniqueness by ID key requires file-scoped external verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Responsibility_Assignment_Conditions",
    "Authority_Exercise_Conditions"
  ],
  "properties": {
    "Responsibility_Assignment_Conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rac_condition"
      }
    },
    "Authority_Exercise_Conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aec_condition"
      }
    }
  },
  "$defs": {
    "rac_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ID",
        "name",
        "condition_type"
      ],
      "properties": {
        "ID": {
          "type": "string",
          "pattern": "^ID-RAC-[A-F0-9]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "condition_type": {
          "type": "string",
          "enum": [
            "USER_ROLE_ASSIGNMENT",
            "ROLE_HIERARCHY",
            "STATIC_SEPARATION_OF_DUTY"
          ]
        }
      }
    },
    "aec_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ID",
        "name",
        "condition_type"
      ],
      "properties": {
        "ID": {
          "type": "string",
          "pattern": "^ID-AEC-[A-F0-9]{32}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "condition_type": {
          "type": "string",
          "enum": [
            "ROLE_AUTHORIZATION",
            "ROLE_ACTIVATION",
            "PERMISSION_ROLE_ASSIGNMENT",
            "TRANSACTION_AUTHORIZATION",
            "DYNAMIC_SEPARATION_OF_DUTY"
          ]
        }
      }
    }
  }
}
