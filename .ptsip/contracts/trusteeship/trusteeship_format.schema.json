{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:trusteeship:v2",
  "title": "PTSIP Trusteeship Responsibility Draft",
  "type": "object",
  "required": [
    "Save_Draft"
  ],
  "properties": {
    "Save_Draft": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "$comment": "Independent UUID32 lowercase hexadecimal identifier, without hyphens; not a content hash."
          },
          "statement": {
            "type": "object",
            "required": [
              "source_policy_id",
              "content"
            ],
            "properties": {
              "source_policy_id": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "object",
                "required": [
                  "Rules"
                ],
                "properties": {
                  "Rules": {
                    "type": "object",
                    "$comment": "Policy-specific semantic responsibility content selected by an agent. Generic internal rule fields and typing are not yet standardized."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
