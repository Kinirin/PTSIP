{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:policy:unified:v3",
  "title": "Common source-preserving policy envelope candidate",
  "$comment": "KEEP_LATEST structural candidate authorized by the project owner. Native source identities, lifecycle values and complete content are retained. Contract bindings are declared per source rule. Candidate schema conformance grants no evaluation, policy activation, publication or execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "Policy_Identity",
    "Policy_Lifecycle",
    "Policy_Authority",
    "Policy_Rules",
    "Policy_Evaluation",
    "Policy_Relationships",
    "Policy_Content",
    "Policy_Migration"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ptsip-unified-policy/v3-candidate"
    },
    "Policy_Identity": {
      "type": "object",
      "required": [
        "id",
        "policy_kind",
        "root_family",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "policy_kind": {
          "enum": [
            "PTSIP_DEVELOPER_POLICY",
            "PTSIP_SUPPORT_FEATURE"
          ]
        },
        "root_family": {
          "enum": [
            "NORM",
            "GOV",
            "INTENT",
            "ARCH",
            "INFO",
            "CNTR",
            "RISK",
            "SUPPLY",
            "REAL",
            "ASSURE",
            "CTRL",
            "CHANGE",
            "OPS",
            "RECORD"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Policy_Lifecycle": {
      "type": "object",
      "required": [
        "status",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "$ref": "#/$defs/item_id"
        }
      }
    },
    "Policy_Authority": {
      "type": "object",
      "required": [
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_id"
          },
          "uniqueItems": true
        }
      }
    },
    "Policy_Rules": {
      "type": "object",
      "required": [
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "Policy_Evaluation": {
      "type": "object",
      "required": [
        "source_refs",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_id"
          },
          "uniqueItems": true
        },
        "state": {
          "const": "UNRESOLVED"
        }
      }
    },
    "Policy_Relationships": {
      "type": "object",
      "required": [
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_id"
          },
          "uniqueItems": true
        }
      }
    },
    "Policy_Content": {
      "type": "object",
      "required": [
        "items",
        "source_document"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "source_pointer",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/item_id"
              },
              "source_pointer": {
                "type": "string",
                "pattern": "^(?:#|/.*|)$"
              },
              "value": {}
            }
          }
        },
        "source_document": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "Policy_Migration": {
      "type": "object",
      "required": [
        "baseline_head",
        "source_format",
        "source_registration",
        "contract_state"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_format": {
          "type": "string",
          "minLength": 1
        },
        "source_registration": {
          "enum": [
            "INDEXED",
            "UNINDEXED"
          ]
        },
        "contract_state": {
          "const": "CANDIDATE"
        }
      }
    }
  },
  "$defs": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_reference": {
      "type": "object",
      "required": [
        "source_ref",
        "item_ref",
        "revision_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "item_ref": {
          "type": "string",
          "pattern": "^(?:#|/.*|)$"
        },
        "revision_ref": {
          "type": "string",
          "pattern": "^git:[0-9a-f]{40}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "state",
        "basis_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "UNRESOLVED",
            "NOT_APPLICABLE",
            "DECLARED"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item_id"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "contract_ref": {
          "$ref": "#/$defs/contract_reference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "DECLARED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "contract_ref"
            ]
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "identity_scheme",
        "kind",
        "source_ref",
        "contract_bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity_scheme": {
          "enum": [
            "DECLARED",
            "SOURCE_COORDINATE"
          ]
        },
        "kind": {
          "enum": [
            "RULE",
            "REQUIREMENT",
            "SEMANTIC_UNIT"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/item_id"
        },
        "contract_bindings": {
          "type": "object",
          "required": [
            "RA",
            "RAC",
            "AEC"
          ],
          "additionalProperties": false,
          "properties": {
            "RA": {
              "$ref": "#/$defs/binding"
            },
            "RAC": {
              "$ref": "#/$defs/binding"
            },
            "AEC": {
              "$ref": "#/$defs/binding"
            }
          }
        }
      }
    }
  }
}
