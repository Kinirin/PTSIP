    },
    "alternative_eligibility_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/ContractSelectionRef"
    }
  },
  "required": [
    "contract_id",
    "revision",
    "relation_type",
    "meaning_ref",
    "logic",
    "alternative_eligibility_ref"
  ],
  "additionalProperties": false
