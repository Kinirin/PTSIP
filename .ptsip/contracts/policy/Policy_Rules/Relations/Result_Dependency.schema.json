      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "relation_type": {
      "const": "result_dependency"
    },
    "meaning_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
    },
    "output_contract_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
    },
    "input_contract_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
    },
    "binding_rule_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
    }
  },
  "required": [
    "contract_id",
    "revision",
    "relation_type",
    "meaning_ref",
    "output_contract_ref",
    "input_contract_ref",
    "binding_rule_ref"
  ],
