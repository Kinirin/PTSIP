{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:contract:policy:types:v2",
  "title": "Policy contract, rule declaration and independent requirement candidates",
  "$comment": "UNAPPROVED_FIELD_CANDIDATE_V2. Common shape tested across five policy documents. Authoring declarations and unresolved bindings are not semantic equivalence, approval or execution authority. Indexed source binding type is connected directly to active common type Contract; no separate Trial schema used for policy validation. Source IDs must be unique and resolvable under their owning Contract, checked separately from JSON Schema.",
  "$defs": {
    "SourceRef": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
    },
    "ContractSelectionRef": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
    },
    "ResponsibilityRef": {
      "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
    },
    "ConditionRef": {
      "$ref": "urn:ptsip:rbac:condition:v1#/$defs/ID"
    },
    "InputBinding": {
      "type": "object",
      "properties": {
        "port_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        },
        "value_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "port_ref",
        "value_refs"
      ],
      "additionalProperties": false
    },
    "ContractBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "DECLARED"
            },
            "selection": {
              "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
            },
            "basis_refs": {
              "type": "array",
              "items": {
                "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "input_bindings": {
              "type": "array",
              "items": {
                "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/InputBinding"
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "selection",
            "basis_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "UNRESOLVED"
            },
            "source_refs": {
              "type": "array",
              "items": {
                "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "source_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "NOT_APPLICABLE"
            },
            "basis_refs": {
              "type": "array",
              "items": {
                "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "state",
            "basis_refs"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ResponsibilityRef"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z]+(?:-[A-Z]+)*$"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ConditionRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        },
        "authority_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "enum": [
              "authority_ref"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "rule",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "responsibility_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ResponsibilityRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "meaning_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "scope_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "condition_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "constraint_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "criteria_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_requirement_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "relation_binding": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ContractBinding"
        },
        "judgement_binding": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ContractBinding"
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "enum": [
              "responsibility_refs",
              "target_refs",
              "scope_refs",
              "condition_refs",
              "constraint_refs",
              "criteria_refs",
              "evidence_requirement_refs"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "empty_field_basis": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "enum": [
                  "responsibility_refs",
                  "target_refs",
                  "scope_refs",
                  "condition_refs",
                  "constraint_refs",
                  "criteria_refs",
                  "evidence_requirement_refs"
                ]
              },
              "basis_refs": {
                "type": "array",
                "items": {
                  "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "field",
              "basis_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requirement_id",
        "responsibility_refs",
        "meaning_refs",
        "target_refs",
        "scope_refs",
        "condition_refs",
        "constraint_refs",
        "criteria_refs",
        "evidence_requirement_refs",
        "relation_binding",
        "judgement_binding",
        "unresolved_fields"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "responsibility_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "responsibility_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "responsibility_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "responsibility_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "responsibility_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "target_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "target_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "target_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "target_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "scope_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "scope_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "scope_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "scope_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "condition_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "condition_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "condition_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "condition_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "condition_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "constraint_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "constraint_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "constraint_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "constraint_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "constraint_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "criteria_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "criteria_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "criteria_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "criteria_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "criteria_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_requirement_refs": {
                "maxItems": 0
              }
            },
            "required": [
              "evidence_requirement_refs"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "unresolved_fields": {
                    "contains": {
                      "const": "evidence_requirement_refs"
                    }
                  }
                },
                "required": [
                  "unresolved_fields"
                ]
              },
              {
                "properties": {
                  "empty_field_basis": {
                    "contains": {
                      "properties": {
                        "field": {
                          "const": "evidence_requirement_refs"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    }
                  }
                },
                "required": [
                  "empty_field_basis"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "required": [
                "empty_field_basis"
              ],
              "properties": {
                "empty_field_basis": {
                  "contains": {
                    "properties": {
                      "field": {
                        "const": "evidence_requirement_refs"
                      }
                    },
                    "required": [
                      "field"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "SourceItem": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "rule",
            "scope",
            "statement",
            "constraint",
            "criterion",
            "record",
            "annotation"
          ]
        },
        "source_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        }
      },
      "required": [
        "item_id",
        "role",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "Contract": {
      "oneOf": [
        {
          "$ref": "#/$defs/LegacyInlineContract"
        },
        {
          "$ref": "#/$defs/IndexedContract"
        }
      ],
      "$comment": "Two explicitly discriminated serializations in the same registered common v2 types contract. INDEXED_SOURCE_BINDINGS MUST NOT fall back to legacy inline when invalid; neither representation conveys policy approval."
    },
    "ParticipantBinding": {
      "type": "object",
      "properties": {
        "port_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        },
        "responsibility_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ResponsibilityRef"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "port_ref",
        "responsibility_ref",
        "target_refs"
      ],
      "additionalProperties": false
    },
    "RelationUse": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:contract-selection:v1"
        },
        "participant_bindings": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v2#/$defs/ParticipantBinding"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "applicability_basis_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "binding_id",
        "relation_ref",
        "participant_bindings",
        "applicability_basis_refs"
      ],
      "additionalProperties": false
    },
    "IndexedSourceID": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "IndexedDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "revision_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_ref",
        "revision_ref"
      ]
    },
    "IndexedSourceItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "item_ref": {
          "type": "string",
          "pattern": "^(#|/)"
        },
        "original_role": {
          "enum": [
            "rule",
            "scope",
            "statement",
            "constraint",
            "criterion",
            "record",
            "annotation"
          ]
        }
      },
      "required": [
        "id",
        "document_id",
        "item_ref",
        "original_role"
      ]
    },
    "IndexedSourceUse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "MEANING",
            "TARGET",
            "SCOPE",
            "CONDITION",
            "CONSTRAINT",
            "CRITERION"
          ]
        },
        "state": {
          "enum": [
            "SOURCE_IDENTIFIED",
            "UNRESOLVED",
            "CONFIRMED_EMPTY",
            "NOT_APPLICABLE"
          ]
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexedSourceID"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "basis_ref_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IndexedSourceID"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "purpose",
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "SOURCE_IDENTIFIED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "ref_ids"
            ],
            "not": {
              "required": [
                "basis_ref_ids"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "ref_ids"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFIRMED_EMPTY"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "basis_ref_ids"
            ],
            "not": {
              "required": [
                "ref_ids"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "basis_ref_ids"
            ],
            "not": {
              "required": [
                "ref_ids"
              ]
            }
          }
        }
      ]
    },
    "IndexedResponsibilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "DECLARED",
            "UNRESOLVED",
            "CONFIRMED_EMPTY",
            "NOT_APPLICABLE"
          ]
        },
        "responsibility_refs": {
          "type": "array",
