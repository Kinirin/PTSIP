{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:contract:policy:field-binding-trial:v1",
  "title": "Shared source-index / closed purpose-state binding trial; UNREGISTERED",
  "$comment": "Omitted purpose is UNRESOLVED, never empty/NA. SOURCE_IDENTIFIED reports reference identification, not semantic confirmation. This trial is not the active route. Cross-reference and semantic checks are separate. Identity, lifecycle and R-ID shapes reuse registered external contracts; this trial does not replace their authority.",
  "type": "object",
  "required": [
    "Policy_Identity",
    "Policy_Status",
    "Policy_Rules"
  ],
  "additionalProperties": false,
  "properties": {
    "Policy_Identity": {
      "$ref": "urn:ptsip:candidate:contract:policy:identity:v1"
    },
    "Policy_Status": {
      "$ref": "urn:ptsip:candidate:contract:policy:lifecycle:v1"
    },
    "Policy_Rules": {
      "type": "object",
      "required": [
        "contracts"
      ],
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contract"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "Document": {
      "type": "object",
      "required": [
        "id",
        "path",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "description": "Exact immutable revision is required at resolution; no Git-only transport requirement in generic field candidate"
        }
      }
    },
    "SourceItem": {
      "type": "object",
      "required": [
        "id",
        "document_id",
        "item_ref",
        "original_role"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "item_ref": {
          "type": "string",
          "pattern": "^/"
        },
        "original_role": {
          "enum": [
            "rule",
            "scope",
            "statement",
            "constraint",
            "criterion",
            "record",
            "annotation"
          ]
        }
      }
    },
    "Binding": {
      "type": "object",
      "required": [
        "purpose",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "MEANING",
            "TARGET",
            "SCOPE",
            "CONDITION",
            "CONSTRAINT",
            "CRITERION",
            "EVIDENCE_REQUIREMENT",
            "EVIDENCE",
            "RESPONSIBILITY",
            "AUTHORITY",
            "RELATION",
            "JUDGEMENT",
            "HISTORICAL_RESULT"
          ]
        },
        "state": {
          "enum": [
            "SOURCE_IDENTIFIED",
            "UNRESOLVED",
            "CONFIRMED_EMPTY",
            "NOT_APPLICABLE"
          ]
        },
        "ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "basis_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "responsibility_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "SOURCE_IDENTIFIED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "ref_ids"
                ],
                "not": {
                  "required": [
                    "responsibility_ids"
                  ]
                }
              },
              {
                "required": [
                  "responsibility_ids"
                ],
                "not": {
                  "required": [
                    "ref_ids"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "CONFIRMED_EMPTY",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "basis_ref_ids"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ref_ids"
                  ]
                },
                {
                  "required": [
                    "responsibility_ids"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ref_ids"
                  ]
                },
                {
                  "required": [
                    "responsibility_ids"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "Rule": {
      "type": "object",
      "required": [
        "id",
        "rule",
        "source_item_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "source_item_id": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        }
      }
    },
    "Requirement": {
      "type": "object",
      "required": [
        "requirement_id",
        "bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "Contract": {
      "type": "object",
      "required": [
        "contract_id",
        "Rule_ver",
        "source_documents",
        "source_items",
        "rules",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "Rule_ver": {
          "type": "string",
          "minLength": 1
        },
        "source_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Document"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceItem"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "uniqueItems": true
        },
        "historical_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Binding"
          }
        }
      }
    }
  },
  "x-ptsip-candidate-semantics": {
    "status": "TRIAL_ONLY_NOT_EFFECTIVE_POLICY",
    "absent_purpose_state": "UNRESOLVED",
    "source_identified_claim": "REFERENCE_IDENTITY_ONLY",
    "confirmed_empty_or_not_applicable": "REQUIRES_SOURCE_BASIS",
    "source_documents_role": "ADDRESS_AND_IMMUTABLE_REVISION_NOT_NORMATIVE_AUTHORITY",
    "source_items_role": "SOURCE_POINTER_AND_NON_NORMATIVE_CLASSIFICATION",
    "responsibility_binding_role": "LINK_ONLY_NOT_APPROVAL",
    "relation_and_judgement": "NO_IMPLICIT_CONTRACT_SELECTION",
    "per_contract_source_id_unique": true,
    "per_contract_requirement_id_unique": true,
    "exact_reference_resolution": "EXTERNAL_SEPARATE_CHECK_REQUIRED"
  }
}
