{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:contract:policy:evaluation-record:v2",
  "title": "policy:evaluation-record",
  "$comment": "UNAPPROVED common evaluation record candidate. Relation sections are present only when responsibility relations are recorded; a scalar requirement does not require a fabricated relation summary.",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "urn:ptsip:candidate:contract:policy:evaluation-context:v1"
    },
    "resolved_contracts": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:candidate:contract:policy:reference:resolved-contract:v1"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relation_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_binding_id": {
            "type": "string",
            "minLength": 1
          },
          "assessment_a_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "assessment_b_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "correspondence_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          }
        },
        "required": [
          "relation_binding_id",
          "assessment_a_ref",
          "assessment_b_ref",
          "correspondence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "application_resolution": {
      "type": "object",
      "properties": {
        "applied_binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "condition_not_met_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved_application_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "applied_binding_ids",
        "condition_not_met_refs",
        "unresolved_application_refs"
      ],
      "additionalProperties": false
    },
    "relation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_binding_id": {
            "type": "string",
            "minLength": 1
          },
          "context_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "outcome_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "relation_binding_id",
          "context_ref",
          "outcome_ref",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "summary_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
        },
        "individual_result_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "non_satisfaction_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "summary_ref",
        "individual_result_refs",
        "non_satisfaction_refs",
        "unresolved_refs"
      ],
      "additionalProperties": false
    },
    "judgement_result_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
    },
    "evidence_bindings": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:candidate:contract:policy:evidence-binding:v1"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "criterion_result_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:candidate:contract:policy:reference:source:v1"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "context",
    "resolved_contracts",
    "evidence_bindings"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "relation_assessments": [
      "application_resolution",
      "relation_results",
      "summary"
    ],
    "application_resolution": [
      "relation_assessments",
      "relation_results",
      "summary"
    ],
    "relation_results": [
      "relation_assessments",
      "application_resolution",
      "summary"
    ],
    "summary": [
      "relation_assessments",
      "application_resolution",
      "relation_results"
    ]
  }
}
