{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:contract:policy:evaluation-record:v1",
  "title": "policy:evaluation-record",
  "$comment": "FIELD_REVIEW_CANDIDATE: created by explicit user instruction on 2026-11-01. Not registered for active selection; no policy migration, evaluator, execution permission, or semantic conformance is implied. Field names and constraints await review.",
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
        },
        "target_scope_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
        },
        "evaluation_case_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
        }
      },
      "required": [
        "context_id",
        "requirement_ref",
        "target_scope_ref",
        "evaluation_case_ref"
      ],
      "additionalProperties": false
    },
    "resolved_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "resolved_version": {
            "type": "string",
            "minLength": 1
          },
          "content_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "compatibility_evidence_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "selection_evidence_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          }
        },
        "required": [
          "request_ref",
          "contract_ref",
          "resolved_version",
          "content_ref",
          "compatibility_evidence_ref",
          "selection_evidence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "relation_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_binding_id": {
            "type": "string",
            "minLength": 1
          },
          "assessment_a_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "assessment_b_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "correspondence_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          }
        },
        "required": [
          "relation_binding_id",
          "assessment_a_ref",
          "assessment_b_ref",
          "correspondence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "application_resolution": {
      "type": "object",
      "properties": {
        "applied_binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "condition_not_met_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved_application_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "applied_binding_ids",
        "condition_not_met_refs",
        "unresolved_application_refs"
      ],
      "additionalProperties": false
    },
    "relation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_binding_id": {
            "type": "string",
            "minLength": 1
          },
          "context_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "outcome_ref": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "relation_binding_id",
          "context_ref",
          "outcome_ref",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "properties": {
        "summary_ref": {
          "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
        },
        "individual_result_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "non_satisfaction_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unresolved_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "summary_ref",
        "individual_result_refs",
        "non_satisfaction_refs",
        "unresolved_refs"
      ],
      "additionalProperties": false
    },
    "judgement_result_ref": {
      "$ref": "urn:ptsip:candidate:contract:policy:types:v1#/$defs/SourceRef"
    }
  },
  "required": [
    "context",
    "resolved_contracts",
    "relation_assessments",
    "application_resolution",
    "relation_results",
    "summary"
  ],
  "additionalProperties": false
}
