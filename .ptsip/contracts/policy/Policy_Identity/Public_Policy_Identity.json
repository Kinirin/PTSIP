{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:identity:policy:v1",
  "title": "PTSIP Policy Identity Vocabularies",
  "$comment": "Single owner of policy_kind and root_family values. Identity document layout and policy authority remain separate contracts.",
  "type": "object",
  "properties": {
    "policy_kind": {
      "$ref": "#/$defs/policy_kind"
    },
    "root_family": {
      "$ref": "#/$defs/root_family"
    }
  },
  "required": [
    "policy_kind",
    "root_family"
  ],
  "$defs": {
    "policy_kind": {
      "type": "string",
      "enum": [
        "PTSIP_DEVELOPER_POLICY",
        "PTSIP_SUPPORT_FEATURE"
      ]
    },
    "root_family": {
      "type": "string",
      "enum": [
        "NORM",
        "GOV",
        "INTENT",
        "ARCH",
        "INFO",
        "CNTR",
        "RISK",
        "SUPPLY",
        "REAL",
        "ASSURE",
        "CTRL",
        "CHANGE",
        "OPS",
        "RECORD"
      ]
    }
  }
}
