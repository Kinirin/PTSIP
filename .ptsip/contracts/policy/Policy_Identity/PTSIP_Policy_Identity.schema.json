{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:identity:v2",
  "title": "PTSIP Policy Identity",
  "type": "object",
  "required": [
    "id",
    "policy_kind",
    "root_family"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "policy_kind": {
      "$ref": "urn:ptsip:identity:policy:v1#/$defs/policy_kind"
    },
    "root_family": {
      "$ref": "urn:ptsip:identity:policy:v1#/$defs/root_family"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "Keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
