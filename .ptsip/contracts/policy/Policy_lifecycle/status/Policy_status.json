{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:candidate:contract:policy:status:v1",
  "title": "PTSIP Unified Policy Status Vocabulary",
  "$comment": "Single owner of the existing DRAFT, APPROVED and RETIRED status values. Membership does not authorize a lifecycle transition.",
  "type": "string",
  "enum": [
    "DRAFT.Default",
    "DRAFT.Reviewed",
    "DRAFT.Denied",
    "DRAFT.Pass",
    "APPROVED.Default",
    "APPROVED.Applying",
    "APPROVED.Application_Problems",
    "APPROVED.Unresolved",
    "APPROVED.Activate",
    "APPROVED.provisional",
    "RETIRED.Default",
    "RETIRED.Removable",
    "RETIRED.Waiting"
  ]
}
