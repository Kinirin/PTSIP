{
  "$schema": "../../schemas/Policy/Policy_Rules/Family_Rules_Contract.schema.json",
  "$id": "urn:ptsip:contract:policy:rules:GOV:v2",
  "schema_version": "ptsip-family-rules/v2",
  "root_family": "GOV",
  "generation": {
    "default": "OMIT",
    "when_root_family": "GOV"
  },
  "structure": {
    "type": "object",
    "required": [
      "Identity",
      "Definition",
      "Boundary",
      "Evaluation"
    ],
    "properties": {
      "Identity": {
        "type": "object",
        "required": [
          "contract_id",
          "Rule_ver"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^urn:ptsip:policy:rule:gov:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "Rule_ver": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "Definition": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "rule"
          ],
          "properties": {
            "id": {
              "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
            },
            "rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[A-Z]+(?:-[A-Z]+)*$"
            },
            "preconditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:ptsip:rbac:condition:v1#/$defs/ID"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "Boundary": {
        "type": "object",
        "required": [
          "scope",
          "subjects"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      },
      "Evaluation": {
        "type": "object",
        "required": [
          "criteria"
        ],
        "properties": {
          "criteria": {
            "type": "object",
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "no_approval_result": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "method": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "outcome_ref": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "result": {
            "type": "object",
            "required": [
              "status",
              "task_name",
              "task_id"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "Perfect_fulfillment",
                  "incomplete_fulfillment",
                  "unfulfillable",
                  "dangerous_defects",
                  "serious_defects"
                ]
              },
              "task_name": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "additionalProperties": true,
    "not": {
      "anyOf": [
        {
          "required": [
            "Constraints"
          ]
        },
        {
          "required": [
            "state"
          ]
        }
      ]
    }
  }
}
