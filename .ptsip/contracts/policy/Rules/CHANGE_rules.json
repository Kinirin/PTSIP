{
  "$schema": "../../schemas/Policy/Policy_Rules/Family_Rules_Contract.schema.json",
  "$id": "urn:ptsip:contract:policy:rules:CHANGE:v2",
  "schema_version": "ptsip-family-rules/v2",
  "root_family": "CHANGE",
  "generation": {
    "default": "OMIT",
    "when_root_family": "CHANGE"
  },
  "structure": {
    "type": "object",
    "properties": {
      "Identity": {
        "type": "object",
        "required": [
          "contract_id",
          "Rule_ver"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "pattern": "^urn:ptsip:policy:rule:change:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "Rule_ver": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "Definition": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id",
            "rule"
          ],
          "properties": {
            "id": {
              "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
            },
            "rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[A-Z]+(?:-[A-Z]+)*$"
            },
            "preconditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "urn:ptsip:rbac:condition:v1#/$defs/ID"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "Boundary": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "environment": {},
              "phase": {}
            }
          }
        },
        "required": [
          "scope",
          "subjects"
        ]
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "criteria": {
            "type": "object",
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "method": {
            "type": "object",
            "properties": {
              "ref": {},
              "outcome_ref": {}
            }
          }
        },
        "required": [
          "criteria"
        ]
      },
      "title": {
        "type": "string"
      }
    },
    "required": [
      "Identity",
      "Definition",
      "Boundary",
      "Evaluation",
      "title"
    ],
    "additionalProperties": true,
    "not": {
      "anyOf": [
        {
          "required": [
            "Constraints"
          ]
        },
        {
          "required": [
            "state"
          ]
        }
      ]
    }
  }
}
