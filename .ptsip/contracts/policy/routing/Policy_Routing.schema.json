{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:policy-routing:v5",
  "title": "Compact policy output routing; family rules are selected by the policy boundary",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-routing/v5"
    },
    "identity_sources": {
      "type": "object",
      "required": [
        "policy_kind",
        "root_family"
      ],
      "properties": {
        "policy_kind": {
          "const": ".ptsip/contracts/policy/Policy_Identity/Public_Policy_Identity.json"
        },
        "root_family": {
          "const": ".ptsip/contracts/policy/Policy_Identity/Public_Policy_Identity.json"
        }
      },
      "additionalProperties": false
    },
    "schema_refs": {
      "type": "object",
      "required": [
        "public",
        "rules"
      ],
      "properties": {
        "public": {
          "const": ".ptsip/contracts/policy/PTSIP_Public_Policy_Structure.schema.json"
        },
        "rules": {
          "const": ".ptsip/contracts/policy/Policy_Rules/Public_Policy_Rules.schema.json"
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:ptsip:identity:policy:v1#/$defs/policy_kind"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "output_root"
        ],
        "properties": {
          "output_root": {
            "type": "string",
            "enum": [
              "developer/policy",
              "src/policy"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "identity_sources",
    "schema_refs",
    "routes"
  ],
  "additionalProperties": false
}
