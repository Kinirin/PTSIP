{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:policy-routing:v4",
  "title": "Compact policy output routing; family rules are selected by the policy boundary",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-routing/v4"
    },
    "identity_sources": {
      "type": "object",
      "required": [
        "policy_kind",
        "root_family"
      ],
      "properties": {
        "policy_kind": {
          "const": ".ptsip/contracts/policy/identity/policy_kind.json"
        },
        "root_family": {
          "const": ".ptsip/contracts/policy/identity/root_family.json"
        }
      },
      "additionalProperties": false
    },
    "schema_refs": {
      "type": "object",
      "required": [
        "public",
        "rules"
      ],
      "properties": {
        "public": {
          "const": ".ptsip/contracts/schemas/Policy/PTSIP_Public_Structure.schema.json"
        },
        "rules": {
          "const": ".ptsip/contracts/schemas/Policy/Policy_Rules/Public_Structure_Rules.schema.json"
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:ptsip:identity:policy-kind:v1"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "output_root"
        ],
        "properties": {
          "output_root": {
            "type": "string",
            "enum": [
              "developer/policy",
              "src/policy"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "identity_sources",
    "schema_refs",
    "routes"
  ],
  "additionalProperties": false
}
