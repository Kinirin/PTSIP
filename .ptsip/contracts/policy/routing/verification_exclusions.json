  "applies_to": [
    "CURRENT_POLICY_AUTHORITY_DISCOVERY",
    "CURRENT_POLICY_DOCUMENT_OR_SCHEMA_VALIDATION",
    "MANDATORY_POLICY_VERIFICATION_AND_ADMISSION_GATES"
  ],
  "does_not_disable": [
    "INDEPENDENT_IMPLEMENTATION_REGRESSION_TESTS",
    "NON_NORMATIVE_HISTORICAL_AUDIT_OUTSIDE_POLICY_ADMISSION"
  ],
  "legacy_policy_identity_pattern": "^MPD-[0-9]{4}$",
  "historical_migration_reconstruction_required_for_current_policy_pass": false,
  "successor_policy_verification_claim": "ONLY_WHEN_VALIDATOR_AND_CURRENT_POLICY_CONTRACT_ARE_VERIFIED",
  "current_root_family_policy_path_pattern": "developer/policy/{FAMILY}/MPD-{FAMILY}-{NNNN}.yaml",
  "current_contract_roots": [
    ".ptsip/contracts/policy/",
    ".ptsip/contracts/schemas/"
  ],
  "on_referenced_retired_source": "EXCLUDE_FROM_CURRENT_POLICY_VERIFICATION_NO_FALLBACK",
  "on_unsupported_successor_validation": "REPORT_UNVERIFIED_NOT_PASS"
}
