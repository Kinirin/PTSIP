{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Status:v2",
  "title": "PTSIP Shared Flat Policy_Status Structure",
  "type": "object",
  "required": [
    "Policy_Status_Schema_ver",
    "status",
    "contract"
  ],
  "additionalProperties": false,
  "properties": {
    "Policy_Status_Schema_ver": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "oneOf": [
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_approved:v2#/properties/status"
        },
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_draft:v2#/properties/status"
        },
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_retired:v2#/properties/status"
        }
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^urn:[^:]+:contract:policy:(?:norm|gov|intent|arch|info|cntr|risk|supply|real|assure|ctrl|change|ops|record):[a-z0-9-]+:[a-z0-9-]+$"
    }
  }
}
