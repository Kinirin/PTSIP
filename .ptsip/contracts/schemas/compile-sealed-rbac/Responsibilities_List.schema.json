{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:rbac:responsibilities-list:v3",
  "title": "Editable responsibility-authority profile list",
  "type": "object",
  "properties": {
    "ptsip": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pp.2.01"
        },
        "revision": {
          "type": "string",
          "pattern": "^Rev\\.[0-9]{4,}$"
        },
        "profile_role": {
          "const": "RESPONSIBILITY-AUTHORITY"
        },
        "specification": {
          "type": "object",
          "required": [
            "source",
            "revision"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      },
      "required": [
        "version",
        "revision",
        "profile_role",
        "specification"
      ],
      "additionalProperties": true
    },
    "responsibility_map": {
      "type": "object",
      "required": [
        "mode",
        "contract_ref"
      ],
      "properties": {
        "mode": {
          "const": "explicit"
        },
        "contract_ref": {
          "const": ".ptsip/contracts/Responsibility-Authority/Responsibility-Authority.json"
        }
      }
    },
    "responsibility": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:rbac:responsibility:v1"
      }
    },
    "component_bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
      },
      "patternProperties": {
        "^R-ID-[A-F0-9]{32}$": {
          "type": "object",
          "required": [
            "rule",
            "status"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[A-Z]+(?:-[A-Z]+)*$"
            },
            "status": {
              "$ref": "urn:ptsip:rbac:lifecycle:index:v1#/$defs/Status"
            },
            "condition_id": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "urn:ptsip:rbac:condition:v1#/$defs/ID"
              }
            },
            "condition_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[A-Z]+(?:-[A-Z]+)*$"
            },
            "Authorization_ID": {
              "$ref": "urn:ptsip:rbac:authorization-intention:v1#/$defs/ID"
            }
          },
          "additionalProperties": false,
          "dependentRequired": {
            "condition_name": [
              "condition_id"
            ],
            "condition_id": [
              "condition_name"
            ]
          },
          "not": {
            "required": [
              "live_policy"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "ptsip",
    "responsibility_map",
    "responsibility",
    "component_bindings"
  ],
  "additionalProperties": true,
  "$comment": "R-ID keyed responsibility and condition mapping; no knowledge of policy documents. Optional authorization link resolves only explicit authorization rule IDs.",
  "not": {
    "required": [
      "component_map"
    ]
  }
}
