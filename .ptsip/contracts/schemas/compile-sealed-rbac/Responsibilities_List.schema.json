{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:rbac:responsibilities-list:v1",
  "title": "Editable responsibility-authority profile list",
  "type": "object",
  "properties": {
    "ptsip": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pp.2.01"
        },
        "revision": {
          "type": "string",
          "pattern": "^Rev\\.[0-9]{4,}$"
        },
        "profile_role": {
          "const": "RESPONSIBILITY-AUTHORITY"
        },
        "specification": {
          "type": "object",
          "required": [
            "source",
            "revision"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      },
      "required": [
        "version",
        "revision",
        "profile_role",
        "specification"
      ],
      "additionalProperties": true
    },
    "responsibility_map": {
      "type": "object",
      "required": [
        "mode",
        "contract_ref"
      ],
      "properties": {
        "mode": {
          "const": "explicit"
        },
        "contract_ref": {
          "const": ".ptsip/contracts/Responsibility-Authority/Responsibility-Authority.json"
        }
      }
    },
    "responsibility": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:rbac:responsibility:v1"
      }
    },
    "component_map": {
      "type": "object",
      "required": [
        "mode",
        "profile_ref",
        "scope",
        "execution_authorized"
      ],
      "properties": {
        "mode": {
          "const": "explicit"
        },
        "profile_ref": {
          "const": ".ptsip/profiles/main.ptsip.yaml"
        },
        "scope": {
          "const": "DECLARED_COMPONENT_METADATA_ONLY"
        },
        "execution_authorized": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "component_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "release_owner",
          "compatibility_owner",
          "runtime_required"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "IMPLEMENTATION",
                "VERIFICATION",
                "AUTOMATION",
                "CONFIGURATION",
                "DOCUMENTATION",
                "GOVERNANCE"
              ]
            }
          },
          "release_owner": {
            "type": "string",
            "minLength": 1
          },
          "compatibility_owner": {
            "type": "string",
            "minLength": 1
          },
          "runtime_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "ptsip",
    "responsibility_map",
    "responsibility"
  ],
  "additionalProperties": true,
  "dependentRequired": {
    "component_map": [
      "component_bindings"
    ],
    "component_bindings": [
      "component_map"
    ]
  },
  "$comment": "Component owner labels are preserved declaration metadata only; they never synthesize conditions, operational authorities, execution approval or runtime activation."
}
