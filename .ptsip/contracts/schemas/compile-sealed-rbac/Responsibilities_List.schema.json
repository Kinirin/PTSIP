{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:rbac:responsibilities-list:v2",
  "title": "Editable responsibility-authority profile list",
  "type": "object",
  "properties": {
    "ptsip": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pp.2.01"
        },
        "revision": {
          "type": "string",
          "pattern": "^Rev\\.[0-9]{4,}$"
        },
        "profile_role": {
          "const": "RESPONSIBILITY-AUTHORITY"
        },
        "specification": {
          "type": "object",
          "required": [
            "source",
            "revision"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        }
      },
      "required": [
        "version",
        "revision",
        "profile_role",
        "specification"
      ],
      "additionalProperties": true
    },
    "responsibility_map": {
      "type": "object",
      "required": [
        "mode",
        "contract_ref"
      ],
      "properties": {
        "mode": {
          "const": "explicit"
        },
        "contract_ref": {
          "const": ".ptsip/contracts/Responsibility-Authority/Responsibility-Authority.json"
        }
      }
    },
    "responsibility": {
      "type": "array",
      "items": {
        "$ref": "urn:ptsip:rbac:responsibility:v1"
      }
    },
    "component_bindings": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:ptsip:rbac:responsibility:v1#/$defs/ID"
      },
      "patternProperties": {
        "^R-ID-[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "type": "object",
          "required": [
            "rule",
            "Rule_state"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_.-]+$"
            },
            "Rule_state": {
              "$ref": "urn:ptsip:rbac:operational-authority:v1#/$defs/RuleState"
            },
            "condition_id": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "urn:ptsip:rbac:condition:v1#/$defs/ID"
              }
            },
            "source_policy": {
              "type": "string"
            },
            "source_rule_id": {
              "type": "string"
            },
            "source_text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "ptsip",
    "responsibility_map",
    "responsibility",
    "component_bindings"
  ],
  "additionalProperties": true,
  "$comment": "Rule constants and states are keyed by Responsibility ID. Existing component owner metadata is retired."
}
