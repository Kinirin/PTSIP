{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:rbac:condition:v1",
  "title": "Responsibility execution condition declaration",
  "type": "object",
  "properties": {
    "ID": {
      "$ref": "#/$defs/ID"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "ID",
    "name"
  ],
  "additionalProperties": true,
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 6,
      "maxLength": 256,
      "pattern": "^C-ID-[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
