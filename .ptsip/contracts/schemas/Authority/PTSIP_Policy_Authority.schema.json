{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Policy_Authority:v3",
  "title": "PTSIP Policy Authority",
  "type": "object",
  "required": [
    "authority_id",
    "Authority_Category",
    "Authority_Action"
  ],
  "properties": {
    "Authority_Category": {
      "type": "object",
      "properties": {
        "Authority_Major_Category": {
          "$ref": "urn:ptsip:policy:authority_category:authority_major:v2"
        }
      },
      "additionalProperties": false,
      "required": [
        "Authority_Major_Category"
      ]
    },
    "Authority_Action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ref"
      ],
      "properties": {
        "action_ref": {
          "type": "string",
          "pattern": "^urn:ptsip:authority:action:(policy|plan|avatar):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
