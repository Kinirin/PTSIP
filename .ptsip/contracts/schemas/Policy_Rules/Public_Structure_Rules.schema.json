{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Public_Structure_Rules:v1",
  "type": "object",
  "$defs": {
    "IndependentRuleContract": {
      "type": "object",
      "required": [
        "Identity",
        "Definition",
        "Boundary",
        "Constraints",
        "Evaluation"
      ]
    },
    "RuleState": {
      "type": "string",
      "minLength": 1
    },
    "ObligationState": {
      "type": "object",
      "required": [
        "Rule_state"
      ],
      "properties": {
        "Rule_state": {
          "$ref": "#/$defs/RuleState"
        }
      },
      "additionalProperties": true
    }
  }
}
