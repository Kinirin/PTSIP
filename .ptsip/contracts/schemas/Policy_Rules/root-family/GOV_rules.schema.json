{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:GOV_rules:v6",
  "title": "GOV Policy_Rules in-policy document structure",
  "$comment": "GOV-only migration: versionless independent rule contract ID, typed OBLIGATION/PROHIBITION item ID, preserved obligations and prohibitions in one array. Prohibition state and applicability not inferred.",
  "$ref": "#/$defs/PolicyDocumentRules",
  "$defs": {
    "PolicyDocumentRules": {
      "allOf": [
        {
          "$ref": "urn:ptsip:policy:Public_Structure_Rules:v1#/$defs/IndependentRuleContract"
        },
        {
          "type": "object",
          "required": [
            "Identity",
            "Definition",
            "Boundary",
            "Constraints",
            "Evaluation"
          ],
          "properties": {
            "Identity": {
              "type": "object",
              "required": [
                "contract_id",
                "Rule_ver"
              ],
              "properties": {
                "contract_id": {
                  "type": "string",
                  "pattern": "^urn:ptsip:policy:rule:gov:[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "Rule_ver": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "Definition": {
              "type": "object",
              "required": [
                "meaning"
              ],
              "properties": {
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "Boundary": {
              "type": "object",
              "required": [
                "scope",
                "subjects"
              ],
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "subjects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exclusions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "Constraints": {
              "type": "object",
              "properties": {
                "obligations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "rule"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^(OBLIGATION|PROHIBITION)/[A-Z][A-Z0-9_]*$"
                      },
                      "applies_when": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rule": {
                        "type": "string",
                        "minLength": 1
                      },
                      "Rule_state": {
                        "$ref": "urn:ptsip:policy:Public_Structure_Rules:v1#/$defs/RuleState"
                      }
                    },
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "id": {
                              "pattern": "^OBLIGATION/"
                            }
                          },
                          "required": [
                            "id"
                          ]
                        },
                        "then": {
                          "required": [
                            "applies_when",
                            "Rule_state"
                          ]
                        }
                      }
                    ]
                  }
                },
                "preconditions": {
                  "type": "array"
                },
                "dependencies": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "Evaluation": {
              "type": "object",
              "required": [
                "criteria"
              ],
              "properties": {
                "criteria": {
                  "type": "object",
                  "required": [
                    "evidence"
                  ],
                  "properties": {
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "no_approval_result": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "method": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "outcome_ref": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
