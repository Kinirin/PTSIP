{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:GOV_rules:v5",
  "title": "GOV Policy_Rules in-policy document structure",
  "$comment": "Inline GOV Policy_Rules: Identity uses contract_id and Rule_ver, with document Family inherited from Policy_Identity. Multiple-rule container and rule-ID generator await separate policy decisions.",
  "$ref": "#/$defs/PolicyDocumentRules",
  "$defs": {
    "PolicyDocumentRules": {
      "allOf": [
        {
          "$ref": "urn:ptsip:policy:Public_Structure_Rules:v1#/$defs/IndependentRuleContract"
        },
        {
          "type": "object",
          "required": [
            "Identity",
            "Definition",
            "Boundary",
            "Constraints",
            "Evaluation"
          ],
          "properties": {
            "Identity": {
              "type": "object",
              "required": [
                "contract_id",
                "Rule_ver"
              ],
              "properties": {
                "contract_id": {
                  "type": "string",
                  "minLength": 1
                },
                "Rule_ver": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "Definition": {
              "type": "object",
              "required": [
                "meaning"
              ],
              "properties": {
                "meaning": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "Boundary": {
              "type": "object",
              "required": [
                "scope",
                "subjects"
              ],
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "subjects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exclusions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": true
            },
            "Constraints": {
              "type": "object",
              "properties": {
                "obligations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "condition",
                      "rule",
                      "Rule_state"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "condition": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rule": {
                        "type": "string",
                        "minLength": 1
                      },
                      "Rule_state": {
                        "$ref": "urn:ptsip:policy:Public_Structure_Rules:v1#/$defs/RuleState"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "prohibitions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "operation"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operation": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "preconditions": {
                  "type": "array"
                },
                "dependencies": {
                  "type": "array"
                }
              },
              "additionalProperties": true
            },
            "Evaluation": {
              "type": "object",
              "required": [
                "criteria"
              ],
              "properties": {
                "criteria": {
                  "type": "object",
                  "required": [
                    "evidence"
                  ],
                  "properties": {
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "no_approval_result": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "method": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "outcome_ref": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
