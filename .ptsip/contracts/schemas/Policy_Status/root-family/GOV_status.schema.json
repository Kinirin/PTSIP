{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:status:gov:v1",
  "title": "GOV flat Policy_Status contract (GOV migration only)",
  "type": "object",
  "required": [
    "Policy_Status_Schema_ver",
    "status",
    "contract"
  ],
  "additionalProperties": false,
  "properties": {
    "Policy_Status_Schema_ver": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "APPROVED.Default",
        "APPROVED.Applying",
        "APPROVED.Application_Problems",
        "APPROVED.Unresolved",
        "APPROVED.Activate",
        "APPROVED.provisional",
        "DRAFT.Default",
        "DRAFT.Reviewed",
        "DRAFT.Denied",
        "DRAFT.Pass",
        "RETIRED.Default",
        "RETIRED.Removable",
        "RETIRED.Waiting"
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^urn:ptsip:contract:policy:gov:[a-z0-9-]+:[a-z0-9-]+$"
    }
  },
  "deprecated": true,
  "$comment": "RETIRED_NON_NORMATIVE: GOV-only status schema and independent contract pattern withdrawn. Shared status schema and lifecycle sources are authoritative; historical reference only."
}
