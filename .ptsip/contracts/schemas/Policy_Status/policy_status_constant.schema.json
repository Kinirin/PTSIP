{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:policy-status-constant:v1",
  "title": "PTSIP Policy Status Constants",
  "type": "object",
  "required": [
    "status",
    "substatus",
    "contract"
  ],
  "properties": {
    "status": {},
    "substatus": {},
    "contract": {
      "type": "string",
      "pattern": "^urn:[^:]+:contract:policy:(?:norm|gov|intent|arch|info|cntr|risk|supply|real|assure|ctrl|change|ops|record):[a-z0-9-]+:[a-z0-9-]+$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "#/$defs/policy_fields"
    }
  ],
  "$defs": {
    "status": {
      "oneOf": [
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_draft:v1#/properties/status"
        },
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_approved:v1#/properties/status"
        },
        {
          "$ref": "urn:ptsip:contract:constant:policy_status_retired:v1#/properties/status"
        }
      ]
    },
    "approved_substatus": {
      "$ref": "urn:ptsip:contract:constant:policy_status_approved:v1#/properties/substatus"
    },
    "policy_fields": {
      "type": "object",
      "required": [
        "status",
        "substatus"
      ],
      "oneOf": [
        {
          "properties": {
            "status": {
              "$ref": "urn:ptsip:contract:constant:policy_status_draft:v1#/properties/status"
            },
            "substatus": {
              "$ref": "urn:ptsip:contract:constant:policy_status_draft:v1#/properties/substatus"
            }
          }
        },
        {
          "properties": {
            "status": {
              "$ref": "urn:ptsip:contract:constant:policy_status_approved:v1#/properties/status"
            },
            "substatus": {
              "$ref": "urn:ptsip:contract:constant:policy_status_approved:v1#/properties/substatus"
            }
          }
        },
        {
          "properties": {
            "status": {
              "$ref": "urn:ptsip:contract:constant:policy_status_retired:v1#/properties/status"
            },
            "substatus": {
              "$ref": "urn:ptsip:contract:constant:policy_status_retired:v1#/properties/substatus"
            }
          }
        }
      ]
    }
  },
  "deprecated": true,
  "$comment": "RETIRED_NON_NORMATIVE: Nested status and substatus constant schema is not an active Policy_Status validation contract."
}
