{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Status:v2",
  "title": "PTSIP Shared Flat Policy_Status Structure",
  "type": "object",
  "required": [
    "Policy_Status_Schema_ver",
    "status",
    "contract"
  ],
  "additionalProperties": false,
  "properties": {
    "Policy_Status_Schema_ver": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "APPROVED.Default",
        "APPROVED.Applying",
        "APPROVED.Application_Problems",
        "APPROVED.Unresolved",
        "APPROVED.Activate",
        "APPROVED.provisional",
        "DRAFT.Default",
        "DRAFT.Reviewed",
        "DRAFT.Denied",
        "DRAFT.Pass",
        "RETIRED.Default",
        "RETIRED.Removable",
        "RETIRED.Waiting"
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^urn:[^:]+:contract:policy:(?:norm|gov|intent|arch|info|cntr|risk|supply|real|assure|ctrl|change|ops|record):[a-z0-9-]+:[a-z0-9-]+$"
    }
  }
}
