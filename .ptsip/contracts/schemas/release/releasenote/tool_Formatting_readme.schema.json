{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:docs:format:tool-readme:v1",
  "title": "PTSIP tool release note and technical documentation formatting",
  "allOf": [
    {
      "$ref": "urn:ptsip:docs:format:basic-readme:v1#/$defs/ReleaseNote"
    },
    {
      "properties": {
        "kind": {
          "const": "tool"
        },
        "change": {
          "properties": {
            "component": {
              "pattern": "^tool$"
            },
            "previous_version": {
              "pattern": "^T\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.(?:a|b|rc)[1-9][0-9]*)?$"
            },
            "version": {
              "pattern": "^T\\.[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.(?:a|b|rc)[1-9][0-9]*)?$"
            }
          }
        }
      }
    }
  ],
  "x-markdown-section-order": [
    "Summary",
    "Version changes",
    "Technical details",
    "Documentation"
  ]
}
