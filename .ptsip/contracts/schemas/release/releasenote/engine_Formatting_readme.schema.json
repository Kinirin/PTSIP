{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:docs:format:engine-readme:v1",
  "title": "PTSIP engine release note and technical documentation formatting",
  "allOf": [
    {
      "$ref": "urn:ptsip:docs:format:basic-readme:v1#/$defs/ReleaseNote"
    },
    {
      "properties": {
        "kind": {
          "const": "engine"
        },
        "change": {
          "properties": {
            "component": {
              "pattern": "^engine\\.(?:context|storage|validation|discovery|planning|execution|projection)$"
            },
            "previous_version": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "version": {
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    }
  ],
  "x-markdown-section-order": [
    "Summary",
    "Version changes",
    "Technical details",
    "Documentation"
  ]
}
