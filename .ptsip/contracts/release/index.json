{
  "schema_version": "ptsip-release-contract-index/v2",
  "contract_ref": ".ptsip/contracts/release/Platform/Common/verification-boundary.json",
  "validator_name": "release-admission-check",
  "engine_entry": ".ptsip/engine/developer/main.go",
  "verifier_root": ".ptsip/engine/developer/Distribution/release/",
  "build_verification": {
    "schema_version": "ptsip-build-verification/v1",
    "verifier_root": "src/tests/build",
    "source_binding": "EXACT_GIT_HEAD",
    "publication_authorized": false,
    "source": {
      "product_prefix": "src/ptsip/",
      "schema_config": "src/ptsip/schemas/config.json",
      "schema_groups": ["profile", "Responsibility-Authority"],
      "engine_index": "src/ptsip/engines/index.json",
      "engine_snapshot": "src/ptsip/engines/contracts/engines_registries/derived-snapshot.json",
      "engine_runtime_resources": [
        "src/ptsip/engines/discovery/profile-support.json",
        "src/ptsip/engines/validation/profile-transitions.json"
      ],
      "common_contract_registry": "src/ptsip/common_contract/registry/manifest.json"
    },
    "prebuild": {
      "frontend": "pyproject.toml",
      "required_product_inputs": ["src/build/ptsip_pep517.py", "src/policy/index.yaml"]
    },
    "sdist": {
      "source_descriptor": "ptsip-build-source.json",
      "excluded_prefixes": [
        ".ptsip/contracts/compile-sealed-rbac/",
        ".ptsip/contracts/release/",
        "src/ptsip/compile_sealed_rbac/",
        "src/ptsip/schemas/storage/profile/history/",
        "src/ptsip/specdata/compile-sealed-rbac/",
        "src/ptsip/specdata/ptsip-profile-pp-1.01.schema.json",
        "src/ptsip/specdata/ptsip-profile-pp-1.02.schema.json",
        "src/ptsip/specdata/ptsip-profile-pp-2.00.candidate.schema.json",
        "src/ptsip/specdata/ptsip-profile-pp-2.00.schema.json"
      ]
    },
    "wheel": {
      "engine_origin_suffix": ".dist-info/ptsip-engines.json",
      "common_contract_origin": "ptsip/common_contract/origin.json",
      "go_entrypoint": "ptsip-go",
      "excluded_prefixes": [
        "ptsip/compile_sealed_rbac/",
        "ptsip/schemas/storage/profile/history/",
        "ptsip/specdata/compile-sealed-rbac/",
        "ptsip/specdata/ptsip-profile-pp-1.01.schema.json",
        "ptsip/specdata/ptsip-profile-pp-1.02.schema.json",
        "ptsip/specdata/ptsip-profile-pp-2.00.candidate.schema.json",
        "ptsip/specdata/ptsip-profile-pp-2.00.schema.json"
      ]
    },
    "installation": {
      "environment": "TEMPORARY_VENV",
      "smoke_package": "ptsip",
      "runtime_activation_authorized": false
    }
  },
  "contract_authority": "NONE",
  "normative_policy_activation": "UNRESOLVED",
  "publication_authorized": false,
  "legacy_release_verifier_fallback": false,
  "validation_rules_ref": ".ptsip/contracts/release/Platform/Common/release_validation.json",
  "platform_dimension": "DISTRIBUTION_SERVICE",
  "platforms": [
    {
      "platform": "Common",
      "root": ".ptsip/contracts/release/Platform/Common/",
      "contracts": {
        "admission": ".ptsip/contracts/release/Platform/Common/admission.json",
        "composition": ".ptsip/contracts/release/Platform/Common/composition-contract.json",
        "migration_inventory": ".ptsip/contracts/release/Platform/Common/migration-inventory.json",
        "package_installation": ".ptsip/contracts/release/Platform/Common/package-installation-contract.json",
        "release": ".ptsip/contracts/release/Platform/Common/release-contract.json",
        "release_contract_validation": ".ptsip/contracts/release/Platform/Common/release-contract_validation.json",
        "release_documentation": ".ptsip/contracts/release/Platform/Common/releasenote.json",
        "release_validation": ".ptsip/contracts/release/Platform/Common/release_validation.json",
        "verification_boundary": ".ptsip/contracts/release/Platform/Common/verification-boundary.json",
        "verification": ".ptsip/contracts/release/Platform/Common/verification-contract.json",
        "version_changes": ".ptsip/contracts/release/Platform/Common/versions_different.json",
        "profile_routing": ".ptsip/contracts/release/Platform/Common/profile/index.json",
        "profile_snapshot": ".ptsip/contracts/release/Platform/Common/profile/project-profile-contracts.yaml"
      },
      "validation_ref": ".ptsip/contracts/release/Platform/Common/Common_validation.json"
    },
    {
      "platform": "GitHub",
      "root": ".ptsip/contracts/release/Platform/GitHub/",
      "contracts": {
        "publication_evidence": ".ptsip/contracts/release/Platform/GitHub/publication-evidence.json",
        "release_presentation": ".ptsip/contracts/release/Platform/GitHub/release-presentation.json"
      },
      "validation_ref": ".ptsip/contracts/release/Platform/GitHub/GitHub_validation.json"
    },
    {
      "platform": "PyPI",
      "root": ".ptsip/contracts/release/Platform/PyPI/",
      "contracts": {
        "publisher_routing": ".ptsip/contracts/release/Platform/PyPI/pypi-publishers.json"
      },
      "validation_ref": ".ptsip/contracts/release/Platform/PyPI/PyPI_validation.json"
    }
  ]
}
