{
  "schema_version": "ptsip-release-test/v1",
  "authority_ref": "developer/policy/ASSURE/MPD-ASSURE-0001.yaml#rules.release_mode_verification",
  "workflow": ".github/workflows/tooling-test.yml",
  "mode_registry": ".github/test_modes.yaml",
  "test_change_root": ".ptsip/engine/developer/Distribution/release/test/",
  "production_contract": ".ptsip/contracts/release/composition-contract.json",
  "release_matrix": "SELECTED_COMPONENTS_JOINED_WITH_REQUIRED_AND_EXPLICIT_OPTIONAL_HOSTS",
  "joined_verification": {
    "selection": "PTSIP_PACKAGE_WITH_COMPOSITION_V2",
    "command": "join",
    "matrix": "REGISTERED_HOSTS_AFTER_ALL_COMPONENT_RECEIPTS_PASS",
    "required": "TEMPORARY_RECONCILED_WAIVER_FOR_PTSIP_0_3_8_B6",
    "artifact_pattern": "verification-package-{platform}-{source_sha}"
  },
  "runners": {
    "windows-x64": "windows-2025",
    "linux-x64": "ubuntu-24.04",
    "macos-arm64": "macos-15"
  },
  "required_platforms": [
    "windows-x64",
    "linux-x64"
  ],
  "optional_platforms": [
    "macos-arm64"
  ],
  "default_optional_platforms": [],
  "result_binding": [
    "source_sha",
    "selection_sha256",
    "component",
    "version",
    "platform",
    "artifact_sha256"
  ],
  "macos_not_requested": "NO_JOB_NO_PASS_EVIDENCE",
  "publication_operations": false,
  "external_packaging_tools": [
    "cargo",
    "pip",
    "build",
    "twine"
  ],
  "runtime": {
    "go_version_file": ".ptsip/engine/developer/Distribution/release/test/go.mod",
    "python_version": "3.12",
    "git_fetch_depth": 0,
    "git_history_requirement": "EXACT_SOURCE_PARENTS_AND_IMMUTABLE_COMPONENT_TAGS"
  },
  "production_helpers": {
    "engine_wheel": ".ptsip/engine/developer/Distribution/release/verification/engine/cmd/engine-wheel",
    "controller": ".ptsip/engine/developer/Distribution/release/controller/cmd/ptsip-release"
  },
  "preserved_engine_verifier": "developer/tests/engines/TestIndependentEngineWheel",
  "temporary_join_waiver_ref": "developer/policy/registries/release-20261026-package-join-waiver.json",
  "lightweight_package_verification": {
    "version": "0.3.8b6",
    "profile": "pp.2.00",
    "required_platforms": [
      "windows-x64",
      "linux-x64"
    ],
    "independently_check": [
      "exact_source_sha",
      "selection_sha256",
      "component_artifact_digests",
      "complete_install",
      "canonical_project_version",
      "native_engine_inventory"
    ],
    "no_full_join_repetition": true
  }
}
