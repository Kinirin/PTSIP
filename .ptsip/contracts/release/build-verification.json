{
  "schema_version": "ptsip-build-verification/v1",
  "verifier_root": "src/tests/build",
  "source_binding": "EXACT_GIT_HEAD",
  "publication_authorized": false,
  "source": {
    "product_prefix": "src/ptsip/",
    "schema_config": "src/ptsip/schemas/config.json",
    "schema_groups": ["profile", "Responsibility-Authority"],
    "engine_index": "src/ptsip/engines/index.json",
    "engine_snapshot": "src/ptsip/engines/contracts/engines_registries/derived-snapshot.json",
    "engine_runtime_resources": [
      "src/ptsip/engines/discovery/profile-support.json",
      "src/ptsip/engines/validation/profile-transitions.json"
    ],
    "common_contract_registry": "src/ptsip/common_contract/registry/manifest.json"
  },
  "prebuild": {
    "frontend": "pyproject.toml",
    "required_product_inputs": ["src/ptsip/support/policy/index.yaml"]
  },
  "sdist": {
    "source_descriptor": "ptsip-build-source.json",
    "excluded_prefixes": [
      ".ptsip/contracts/compile-sealed-rbac/",
      ".ptsip/contracts/release/",
      "src/ptsip/specdata/compile-sealed-rbac/"
    ]
  },
  "wheel": {
    "engine_origin_suffix": ".dist-info/ptsip-engines.json",
    "common_contract_origin": "ptsip/common_contract/origin.json",
    "go_entrypoint": "ptsip-go",
    "excluded_prefixes": ["ptsip/specdata/compile-sealed-rbac/"]
  },
  "installation": {
    "environment": "TEMPORARY_VENV",
    "smoke_package": "ptsip",
    "runtime_activation_authorized": false
  }
}
