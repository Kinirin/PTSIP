{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:constant:policy_status_retired:v1",
  "title": "PTSIP RETIRED Status Contract",
  "schema_version": "ptsip-lifecycle-status-constant/v1",
  "type": "object",
  "required": [
    "status",
    "substatus"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "RETIRED"
    },
    "substatus": {
      "type": "string",
      "enum": [
        "Default",
        "Removable",
        "Waiting"
      ]
    }
  }
}
