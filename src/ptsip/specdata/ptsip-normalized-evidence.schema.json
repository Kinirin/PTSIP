{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-normalized-evidence.schema.json",
  "title": "PTSIP Normalized Evidence v1",
  "type": "object",
  "required": ["format", "context", "records", "channels", "issues", "deterministic_digest", "record_count", "conflict_count"],
  "properties": {
    "format": {"const": "ptsip-normalized-evidence/v1"},
    "context": {
      "type": "object",
      "required": ["evaluation_id", "snapshot", "source_generation"],
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1},
        "snapshot": {
          "type": "object",
          "required": ["repository_root", "revision", "status_fingerprint", "tracked_content_fingerprint"],
          "properties": {
            "repository_root": {"type": "string", "minLength": 1},
            "revision": {"type": ["string", "null"]},
            "status_fingerprint": {"type": "string", "minLength": 1},
            "tracked_content_fingerprint": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "source_generation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["profile_path", "version", "specification_revision", "content_sha256"],
              "properties": {
                "profile_path": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "specification_revision": {"type": "string", "minLength": 1},
                "content_sha256": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["semantic_id", "subject", "predicate", "qualifiers", "assertions", "status", "authority"],
        "properties": {
          "semantic_id": {"type": "string", "pattern": "^evidence:[0-9a-f]{24}$"},
          "subject": {"type": "string", "minLength": 1},
          "predicate": {"type": "string", "minLength": 1},
          "qualifiers": {"type": "object"},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "value", "origins"],
              "properties": {
                "id": {"type": "string", "pattern": "^assertion:[0-9a-f]{24}$"},
                "value": {},
                "origins": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["provenance", "adapter", "evidence_id", "source_path", "line", "document_sha256", "producer_id", "basis_ids", "detail"],
                    "properties": {
                      "provenance": {"enum": ["DECLARED", "OBSERVED", "INFERRED"]},
                      "adapter": {"type": "string", "minLength": 1},
                      "evidence_id": {"type": "string", "minLength": 1},
                      "source_path": {"type": ["string", "null"]},
                      "line": {"type": ["integer", "null"], "minimum": 1},
                      "document_sha256": {"type": ["string", "null"]},
                      "producer_id": {"type": ["string", "null"]},
                      "basis_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                      "detail": {"type": ["string", "null"]}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "status": {"enum": ["CONSISTENT", "CONFLICT"]},
          "authority": {"const": "EVIDENCE_ONLY"}
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence_count", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PRODUCED", "NO_MATCH", "NOT_ANALYZED", "FAILED"]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "channel", "evidence_ids"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "channel": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "deterministic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "conflict_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
