{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PTSIP 0.3.4-draft Compatibility Source Profile",
  "type":"object",
  "required":["ptsip","policies"],
  "oneOf":[
    {"required":["boundaries"],"not":{"required":["components"]}},
    {"required":["components"],"not":{"required":["boundaries"]}}
  ],
  "properties":{
    "ptsip":{"type":"object","required":["version","specification"],"properties":{
      "version":{"const":"0.3.4-draft"},
      "specification":{"type":"object","required":["source"],"properties":{
        "source":{"const":"https://github.com/Kinirin/PTSIP"},
        "revision":{"type":"string","minLength":1}
      },"additionalProperties":false}
    },"additionalProperties":false},
    "boundaries":{"type":"object","required":["product","toolchain"],"properties":{
      "product":{"$ref":"#/$defs/rootSet"},"toolchain":{"$ref":"#/$defs/rootSet"},"neutral_contract":{"$ref":"#/$defs/rootSet"}
    },"additionalProperties":false},
    "components":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/component"}},
    "component_dependency_policy":{"$ref":"#/$defs/componentDependencyPolicy"},
    "policies":{"type":"object","required":["product_to_toolchain_runtime_dependency","toolchain_in_product_package","independent_build_resolution"],"properties":{
      "product_to_toolchain_runtime_dependency":{"const":"deny"},
      "toolchain_in_product_package":{"const":"deny"},
      "independent_build_resolution":{"const":"required"},
      "shared_executable_cross_boundary":{"const":"deny"},
      "neutral_contract_sharing":{"enum":["allow","deny"]}
    },"additionalProperties":false}
  },
  "allOf":[{"if":{"required":["component_dependency_policy"]},"then":{"required":["components"]}}],
  "$defs":{
    "rootSet":{"type":"object","required":["roots"],"properties":{"roots":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}},"additionalProperties":false},
    "component":{"type":"object","required":["id","classification","include","purpose"],"properties":{
      "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "classification":{"enum":["PRODUCT","TOOLCHAIN","NEUTRAL_CONTRACT"]},
      "include":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
      "exclude":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "purpose":{"type":"string","minLength":1},
      "shipped":{"type":"boolean"},"runtime_required":{"type":"boolean"},
      "lifecycle_owner":{"enum":["PRODUCT","DEVELOPMENT_TOOLING","INDEPENDENT"]},
      "executable":{"type":"boolean"},"release_owner":{"type":"string","minLength":1},"compatibility_owner":{"type":"string","minLength":1},
      "manifests":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "consumers":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "analysis_inputs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
    },"allOf":[
      {"if":{"properties":{"classification":{"const":"PRODUCT"}},"required":["classification","lifecycle_owner"]},"then":{"properties":{"lifecycle_owner":{"const":"PRODUCT"}}}},
      {"if":{"properties":{"classification":{"const":"TOOLCHAIN"}},"required":["classification"]},"then":{"properties":{"shipped":{"const":false},"runtime_required":{"const":false},"lifecycle_owner":{"const":"DEVELOPMENT_TOOLING"}}}},
      {"if":{"properties":{"classification":{"const":"NEUTRAL_CONTRACT"}},"required":["classification"]},"then":{"required":["executable"],"properties":{"executable":{"const":false},"lifecycle_owner":{"const":"INDEPENDENT"}}}}
    ],"additionalProperties":false},
    "componentDependencyPolicy":{"type":"object","required":["default"],"properties":{"default":{"enum":["allow","deny"]},"allow":{"type":"array","items":{"$ref":"#/$defs/componentDependencyRelation"}},"deny":{"type":"array","items":{"$ref":"#/$defs/componentDependencyRelation"}}},"additionalProperties":false},
    "componentDependencyRelation":{"type":"object","required":["from","to"],"properties":{"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1}},"additionalProperties":false}
  },
  "additionalProperties":false
}
