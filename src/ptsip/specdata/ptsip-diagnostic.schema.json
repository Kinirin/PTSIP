{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kwaksinwoo01/ptsip/main/schemas/ptsip-diagnostic.schema.json",
  "title": "PTSIP Diagnostic v1",
  "type": "object",
  "required": ["format", "diagnostic_id", "rule_id", "outcome_effect", "severity", "evidence_ids", "message", "evaluator"],
  "properties": {
    "format": {"const": "ptsip-diagnostic/v1"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^PTSIP-[A-Z]+-[0-9]{3}$"},
    "outcome_effect": {"enum": ["NON_CONFORMANT", "INCOMPLETE", "NONE"]},
    "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
    "source_component": {"type": ["string", "null"], "minLength": 1},
    "target_component": {"type": ["string", "null"], "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "message": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "required": ["id", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["DECLARED", "OBSERVED", "INFERRED"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
