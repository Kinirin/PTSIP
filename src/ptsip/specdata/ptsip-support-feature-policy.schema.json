{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-support-feature-policy.schema.json",
  "title": "PTSIP Support Feature Policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "policy",
    "feature_contract",
    "authority_contract",
    "authority_semantics",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-support-feature-policy/v1"
    },
    "policy_class": {
      "const": "PTSIP_SUPPORT_FEATURE"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SFP-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "DEPRECATED",
            "RETIRED"
          ]
        }
      },
      "additionalProperties": false
    },
    "feature_contract": {
      "type": "object",
      "required": [
        "shipped",
        "runtime_surface"
      ],
      "properties": {
        "shipped": {
          "const": true
        },
        "runtime_surface": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(src/ptsip|src/vpms)/.+"
          }
        }
      },
      "additionalProperties": true
    },
    "authority_contract": {
      "type": "object",
      "minProperties": 1
    },
    "authority_semantics": {
      "type": "object",
      "minProperties": 1
    },
    "relations": {
      "type": "object",
      "required": [
        "supersedes",
        "amends",
        "extends",
        "depends_on"
      ],
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "required": [
      "source_provenance"
    ]
  },
  "additionalProperties": true
}
