{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kwaksinwoo01/ptsip/main/schemas/ptsip-profile.schema.json",
  "title": "PTSIP Project Profile",
  "type": "object",
  "required": ["ptsip", "policies"],
  "anyOf": [
    {"required": ["boundaries"]},
    {"required": ["components"]}
  ],
  "properties": {
    "ptsip": {
      "type": "object",
      "required": ["version", "specification"],
      "properties": {
        "version": {"type": "string", "const": "0.2.0-draft"},
        "specification": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {"type": "string", "const": "https://github.com/kwaksinwoo01/ptsip"},
            "revision": {"type": "string", "minLength": 1, "description": "Optional immutable commit SHA or release identifier used to bind validation to an exact specification snapshot."}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "required": ["product", "toolchain"],
      "properties": {
        "product": {"$ref": "#/$defs/rootSet"},
        "toolchain": {"$ref": "#/$defs/rootSet"},
        "neutral_contract": {"$ref": "#/$defs/rootSet"}
      },
      "additionalProperties": false
    },
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "policies": {
      "type": "object",
      "required": ["product_to_toolchain_runtime_dependency", "toolchain_in_product_package", "independent_build_resolution"],
      "properties": {
        "product_to_toolchain_runtime_dependency": {"const": "deny"},
        "toolchain_in_product_package": {"const": "deny"},
        "independent_build_resolution": {"const": "required"},
        "shared_executable_cross_boundary": {"enum": ["deny", "exception_required"]},
        "neutral_contract_sharing": {"enum": ["allow", "deny"]}
      },
      "additionalProperties": false
    },
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
  },
  "$defs": {
    "rootSet": {
      "type": "object",
      "required": ["roots"],
      "properties": {"roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "classification", "include", "purpose"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "classification": {"enum": ["PRODUCT", "TOOLCHAIN", "NEUTRAL_CONTRACT"]},
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "purpose": {"type": "string", "minLength": 1},
        "shipped": {"type": "boolean"},
        "executable": {"type": "boolean"},
        "release_owner": {"type": "string", "minLength": 1},
        "compatibility_owner": {"type": "string", "minLength": 1},
        "manifests": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "analysis_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [{"if": {"properties": {"classification": {"const": "NEUTRAL_CONTRACT"}}, "required": ["classification"]}, "then": {"required": ["executable"], "properties": {"executable": {"const": false}}}}],
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["id", "rule", "reason", "affected_components", "coupling", "owner", "review_condition", "decision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "pattern": "^PTSIP-[A-Z]+-[0-9]{3}$"},
        "reason": {"type": "string", "minLength": 1},
        "affected_components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "coupling": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "review_condition": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
