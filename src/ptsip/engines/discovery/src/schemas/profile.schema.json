{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:discovery:profile:v1",
  "title": "Discovery-owned exact Project Profile resource selection",
  "$defs": {
    "contract_input": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "registry_path": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "new_registration": {
          "type": "boolean"
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "contract_output": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "schema_resource": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "LEGACY",
            "DEPRECATED"
          ]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IDENTIFY",
              "VALIDATE",
              "ANALYZE",
              "MIGRATE_SOURCE",
              "CREATE_TARGET"
            ]
          }
        },
        "allowed": {
          "type": "boolean"
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "mandatory"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_id",
        "version",
        "schema_resource",
        "source_sha256",
        "lifecycle",
        "operations",
        "allowed",
        "notifications"
      ],
      "additionalProperties": false
    },
    "catalog_input": {
      "type": "object",
      "properties": {
        "repository_root": {
          "type": "string",
          "minLength": 1
        },
        "requested_profile_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "catalog_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository_root"
      ],
      "additionalProperties": false
    },
    "catalog_output": {
      "type": "object",
      "properties": {
        "selected_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "resource_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "default_new_profile_path": {
          "type": "string",
          "minLength": 1
        },
        "catalog_valid": {
          "type": "boolean"
        },
        "catalog_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "selected_id",
        "resource_path",
        "default_new_profile_path",
        "catalog_valid",
        "catalog_sha256"
      ],
      "additionalProperties": false
    }
  }
}
