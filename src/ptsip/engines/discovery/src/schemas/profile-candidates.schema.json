{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:discovery:profile-candidates:v1",
  "title": "Discovery Profile source and candidate observations",
  "$defs": {
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        },
        "specification_revision": {
          "type": "string",
          "minLength": 1
        },
        "specification_source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "temporary": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "declared_version",
        "specification_revision",
        "specification_source",
        "content_sha256",
        "temporary"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "candidate_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "source",
        "candidates",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  }
}
