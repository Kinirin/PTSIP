{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:discovery:repository:v1",
  "title": "Discovery Repository inventory interface",
  "$defs": {
    "remote": {
      "type": "object",
      "properties": {
        "name": {
          "const": "origin"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provider": {
          "enum": [
            "github",
            null
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "url",
        "host",
        "provider",
        "repository"
      ],
      "additionalProperties": false
    },
    "inspect_input": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "inspect_output": {
      "type": "object",
      "properties": {
        "requested_path": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "is_git": {
          "type": "boolean"
        },
        "commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "remote": {
          "oneOf": [
            {
              "$ref": "#/$defs/remote"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_mode": {
          "enum": [
            "git-tracked",
            "filesystem"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observation_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "requested_path",
        "root",
        "is_git",
        "commit",
        "branch",
        "dirty",
        "remote",
        "file_mode",
        "files",
        "observation_errors"
      ],
      "additionalProperties": false
    }
  }
}
