{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:context:repository:v1",
  "title": "Context Repository observation interface",
  "$defs": {
    "snapshot_input": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "snapshot_output": {
      "type": "object",
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_git": {
          "type": "boolean"
        },
        "head": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_content_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_files": {
          "type": "integer",
          "minimum": 0
        },
        "observation_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "captured_at",
        "is_git",
        "head",
        "status_fingerprint",
        "tracked_content_fingerprint",
        "tracked_files",
        "observation_errors"
      ],
      "additionalProperties": false
    }
  }
}
