{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:validation:profile-state:v1",
  "title": "Validation of declared Profile transition and direct convergence state",
  "$defs": {
    "snapshot": {
      "type": "object",
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_git": {
          "type": "boolean"
        },
        "head": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_content_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_files": {
          "type": "integer",
          "minimum": 0
        },
        "observation_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "captured_at",
        "is_git",
        "head",
        "status_fingerprint",
        "tracked_content_fingerprint",
        "tracked_files",
        "observation_errors"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        },
        "specification_revision": {
          "type": "string",
          "minLength": 1
        },
        "specification_source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "temporary": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "declared_version",
        "specification_revision",
        "specification_source",
        "content_sha256",
        "temporary"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ],
      "additionalProperties": false
    },
    "draft_version": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        },
        "micro": {
          "type": "integer",
          "minimum": 0
        },
        "semantic": {
          "type": "string",
          "minLength": 1
        },
        "draft_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "major",
        "minor",
        "micro",
        "semantic",
        "draft_label"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "declared_version": {
          "type": "string",
          "minLength": 1
        },
        "specification_revision": {
          "type": "string",
          "minLength": 1
        },
        "specification_source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "temporary": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/draft_version"
        }
      },
      "required": [
        "path",
        "declared_version",
        "specification_revision",
        "specification_source",
        "content_sha256",
        "temporary",
        "version"
      ],
      "additionalProperties": false
    },
    "selected_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operations",
        "schema_resource",
        "lifecycle",
        "source_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IDENTIFY",
              "VALIDATE",
              "ANALYZE",
              "MIGRATE_SOURCE",
              "CREATE_TARGET"
            ]
          }
        },
        "schema_resource": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "LEGACY",
            "DEPRECATED"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": "boolean"
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "mandatory"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "registered_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "IDENTITY_ONLY",
            "SEMANTIC_MIGRATION"
          ]
        }
      }
    },
    "historical_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_version",
        "specification_revision",
        "target_contract",
        "transition_kind"
      ],
      "properties": {
        "declared_version": {
          "type": "string",
          "minLength": 1
        },
        "specification_revision": {
          "type": "string",
          "minLength": 1
        },
        "target_contract": {
          "type": "string",
          "minLength": 1
        },
        "transition_kind": {
          "enum": [
            "IDENTITY_ONLY",
            "SEMANTIC_MIGRATION"
          ]
        },
        "legacy_target_filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility_contract": {
          "type": "string",
          "pattern": "^pp\\.(?:0|[1-9][0-9]*)\\.[0-9]{2,}$"
        }
      }
    },
    "transition_state": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "IDLE",
            "SIMPLE",
            "SEQUENTIAL"
          ]
        },
        "canonical_source": {
          "$ref": "#/$defs/generation"
        },
        "temporary_profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generation"
          }
        },
        "final_point": {
          "oneOf": [
            {
              "$ref": "#/$defs/generation"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordered_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generation"
          }
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "repository_root": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "$ref": "#/$defs/snapshot"
            },
            "profiles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/generation"
              }
            }
          },
          "required": [
            "repository_root",
            "repository",
            "profiles"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "canonical_source",
        "temporary_profiles",
        "final_point",
        "ordered_sources",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "convergence_state": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "CURRENT",
            "IDENTITY_ONLY",
            "DIRECT_SEMANTIC_MIGRATION"
          ]
        },
        "source": {
          "$ref": "#/$defs/binding"
        },
        "source_compatibility_contract": {
          "type": "string",
          "pattern": "^pp\\.(?:0|[1-9][0-9]*)\\.[0-9]{2,}$"
        },
        "target_contract": {
          "type": "string",
          "pattern": "^pp\\.(?:0|[1-9][0-9]*)\\.[0-9]{2,}$"
        },
        "transition_kind": {
          "enum": [
            "IDENTITY_ONLY",
            "SEMANTIC_MIGRATION",
            null
          ]
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_is_legacy_alias": {
          "type": "boolean"
        },
        "requires_temporary_target": {
          "type": "boolean"
        },
        "intermediate_profiles": {
          "type": "array",
          "maxItems": 0
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "mode",
        "source",
        "source_compatibility_contract",
        "target_contract",
        "transition_kind",
        "target_path",
        "target",
        "target_is_legacy_alias",
        "requires_temporary_target",
        "intermediate_profiles",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "transition_input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "oneOf": [
                {
                  "$ref": "#/$defs/binding"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/binding"
              }
            },
            "snapshot": {
              "$ref": "#/$defs/snapshot"
            },
            "root": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "candidates",
            "snapshot",
            "root"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "declared_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "declared_version"
              ],
              "additionalProperties": false
            },
            "candidates": {
              "type": "array",
              "maxItems": 0
            },
            "snapshot": {
              "type": "null"
            },
            "root": {
              "type": "null"
            }
          },
          "required": [
            "source",
            "candidates",
            "snapshot",
            "root"
          ],
          "additionalProperties": false
        }
      ]
    },
    "transition_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "valid": {
              "const": true
            },
            "state": {
              "oneOf": [
                {
                  "$ref": "#/$defs/transition_state"
                },
                {
                  "$ref": "#/$defs/draft_version"
                }
              ]
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              },
              "maxItems": 0
            }
          },
          "required": [
            "valid",
            "state",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "valid": {
              "const": false
            },
            "state": {
              "type": "null"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              },
              "minItems": 1
            }
          },
          "required": [
            "valid",
            "state",
            "diagnostics"
          ],
          "additionalProperties": false
        }
      ]
    },
    "convergence_input": {
      "type": "object",
      "properties": {
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/binding"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "selected_contract": {
          "$ref": "#/$defs/selected_contract"
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registered_transition"
          }
        },
        "historical_bridges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historical_bridge"
          }
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "source",
        "candidates",
        "selected_contract",
        "snapshot"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "transitions": [
          "historical_bridges"
        ],
        "historical_bridges": [
          "transitions"
        ]
      }
    },
    "convergence_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "valid": {
              "const": true
            },
            "state": {
              "$ref": "#/$defs/convergence_state"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              },
              "maxItems": 0
            }
          },
          "required": [
            "valid",
            "state",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "valid": {
              "const": false
            },
            "state": {
              "type": "null"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              },
              "minItems": 1
            }
          },
          "required": [
            "valid",
            "state",
            "diagnostics"
          ],
          "additionalProperties": false
        }
      ]
    },
    "transition_catalog": {
      "type": "object",
      "required": [
        "transitions",
        "historical_bridges"
      ],
      "additionalProperties": false,
      "properties": {
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registered_transition"
          }
        },
        "historical_bridges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historical_bridge",
            "required": [
              "compatibility_contract"
            ]
          }
        }
      }
    }
  }
}
