{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine:validation:profile-path:v1",
  "title": "Validation of a repository-relative Profile file path",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "normalized_path": {
          "type": "string",
          "minLength": 1
        },
        "path_on_disk": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "normalized_path",
        "path_on_disk"
      ],
      "additionalProperties": false
    }
  }
}
