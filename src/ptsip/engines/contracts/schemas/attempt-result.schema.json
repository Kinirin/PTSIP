{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:attempt-result:v1",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "PENDING",
        "UNKNOWN"
      ]
    },
    "cause": {
      "enum": [
        "NONE",
        "RESOURCE_EXHAUSTION",
        "REVOKED",
        "CONTRACT_INVALID",
        "UNKNOWN"
      ]
    },
    "effect_evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "attempt_id",
    "status",
    "cause",
    "effect_evidence_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "cause": {
            "const": "RESOURCE_EXHAUSTION"
          }
        },
        "required": [
          "cause"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        }
      }
    }
  ]
}
