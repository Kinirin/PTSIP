{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:derived-state:v1",
  "type": "object",
  "properties": {
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "snapshot_revision": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": false
    },
    "write_permission": {
      "const": false
    },
    "reuse_eligible": {
      "type": "boolean"
    }
  },
  "required": [
    "state_id",
    "source_refs",
    "snapshot_revision",
    "authority",
    "write_permission",
    "reuse_eligible"
  ],
  "additionalProperties": false
}
