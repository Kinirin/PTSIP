{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:storage-mediation:v1",
  "type": "object",
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_owner": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "permission_grant": {
      "const": false
    }
  },
  "required": [
    "capability_id",
    "provider_id",
    "provider_owner",
    "operation_id",
    "provider_operation_id",
    "contract_version",
    "compatibility_ref",
    "permission_grant"
  ],
  "additionalProperties": false
}
