{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:stop-result:v1",
  "type": "object",
  "properties": {
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "STOP_CONFIRMED",
        "STOP_FAILED",
        "PENDING",
        "UNKNOWN"
      ]
    },
    "effect_evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "correlation_id",
    "attempt_id",
    "status",
    "effect_evidence_refs"
  ],
  "additionalProperties": false
}
