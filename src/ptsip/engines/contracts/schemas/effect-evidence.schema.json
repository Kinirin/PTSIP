{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:effect-evidence:v1",
  "type": "object",
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "enum": [
        "OBSERVED_EFFECT",
        "VERIFIED_NO_EFFECT",
        "UNKNOWN",
        "UNVERIFIED"
      ]
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "evidence_id",
    "attempt_id",
    "observation",
    "source_ref"
  ],
  "additionalProperties": false
}
