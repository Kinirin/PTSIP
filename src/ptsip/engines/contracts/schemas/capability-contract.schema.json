{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:engine-data:capability-contract:v1",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "engine_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_owner": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "typed_input",
          "typed_output",
          "preconditions",
          "postconditions",
          "side_effects",
          "declared_permission_requirements",
          "failure_semantics",
          "verification_evidence",
          "compatibility",
          "machine_semantics"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "typed_input": {
            "type": "object"
          },
          "typed_output": {
            "type": "object"
          },
          "preconditions": {
            "type": "array"
          },
          "postconditions": {
            "type": "array"
          },
          "side_effects": {
            "type": "array"
          },
          "declared_permission_requirements": {
            "type": "array"
          },
          "failure_semantics": {
            "type": "object"
          },
          "verification_evidence": {
            "type": "object"
          },
          "compatibility": {
            "type": "object"
          },
          "machine_semantics": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "normative_language": {
      "const": "JSON"
    },
    "execution_permission_from_declaration": {
      "const": false
    }
  },
  "required": [
    "contract_id",
    "version",
    "engine_id",
    "semantic_owner",
    "operations",
    "authority_ref",
    "normative_language",
    "execution_permission_from_declaration"
  ],
  "additionalProperties": false
}
