{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:policy:rules:v4",
  "title": "PTSIP Policy v4 Rules",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "properties": {
              "content_id": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "RA_id": {
            "type": "string",
            "pattern": "^R-ID-[0-9A-F]{32}$",
            "maxLength": 37
          }
        },
        "additionalProperties": false
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "state": {
          "description": "A constant validated against the user's evaluation state contract."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
