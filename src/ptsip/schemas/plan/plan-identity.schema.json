{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:plan:identity",
  "version": "SCH.1.00",
  "title": "PTSIP Plan Identity",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^plan-[a-zA-Z0-9]{4}$"
    },
    "revision": {
      "description": "User-owned Plan document revision. PTSIP does not interpret or update this field."
    }
  },
  "additionalProperties": true,
  "required": ["plan_id"]
}
