{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:plan:public-structure",
  "version": "SCH.1.00",
  "title": "PTSIP Plan Document Structure",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "SchemaVersion": {
      "const": "SCH.1.00"
    },
    "Plan_Identity": {
      "$ref": "urn:ptsip:contract:plan:identity"
    },
    "Plan_lifecycle": {
      "$ref": "urn:ptsip:contract:plan:lifecycle"
    },
    "work_unit_item": {
      "type": "array",
      "items": { "$ref": "urn:ptsip:contract:plan:unit" }
    },
    "contract_vision": false,
    "contract_revision": false,
    "approval_ref": false,
    "implementation_authorized": false,
    "publication_authorized": false,
    "blocked_reason": false,
    "policy_refs": {
      "description": "Each reference identifies a Policy document and a rule owned by that document. The final rule reference encoding remains undecided.",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {}
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "additionalProperties": true,
  "required": ["SchemaVersion"]
}
