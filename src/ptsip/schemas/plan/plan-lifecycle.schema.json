{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:plan:lifecycle",
  "version": "SCH.1.00",
  "title": "PTSIP Plan Lifecycle",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "Draft.Proposed",
        "Draft.Under_coordination",
        "Approval.Scheduled_implementation",
        "Approval.In_progress",
        "Approval.Implementation_complete",
        "Halt.Paused",
        "Halt.Discontinued"
      ]
    },
    "Creation_date": {
      "description": "Recorded Plan creation date."
    },
    "completion_date": {
      "description": "Use null when no completion date has been recorded.",
      "not": { "const": "" }
    },
    "last_modified_date": {
      "description": "Recorded last change to Plan lifecycle status."
    },
    "SchemaVersion": false,
    "approval_ref": false,
    "implementation_authorized": false,
    "publication_authorized": false,
    "blocked_reason": false
  },
  "additionalProperties": true,
  "required": [
    "status"
  ]
}
