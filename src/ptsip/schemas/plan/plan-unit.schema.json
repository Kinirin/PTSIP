{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:plan:unit",
  "version": "SCH.1.00",
  "title": "PTSIP Plan Unit",
  "type": "object",
  "properties": {
    "work_unit_id": {
      "type": "string",
      "pattern": "^WU-[A-Z]{2}-[0-9]{3}$"
    },
    "title": {
      "type": "string"
    },
    "RA_id": {
      "type": "string"
    },
    "task_id": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "value": {
      "type": "array",
      "items": {}
    },
    "dependencies": false,
    "status": false,
    "implementation_authorized": false,
    "session_name": false,
    "session_id": false,
    "pattern": false
  },
  "additionalProperties": true,
  "required": ["work_unit_id", "task_id"]
}
