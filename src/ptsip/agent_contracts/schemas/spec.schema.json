{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ptsip-agent-spec/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "status",
    "normative_rule_refs",
    "statements"
  ],
  "properties": {
    "format": {
      "const": "ptsip-agent-spec/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "BOOTSTRAP",
        "CURRENT",
        "SUPERSEDED"
      ]
    },
    "normative_rule_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement_id",
          "kind",
          "subject",
          "predicate",
          "object"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DEFINITION",
              "REQUIREMENT",
              "PROHIBITION",
              "SEPARATION",
              "INVARIANT"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
