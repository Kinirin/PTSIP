{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:consumer:ptsip:contracts:status:v3",
  "title": "PTSIP Consumer Policy Contract Status",
  "description": "Consumer-owned policy status contract. The status field is one token in {status}.{substatus} form; the enum contains independently embedded permitted pairs. Status transition rules and approval authority are not specified by this schema.",
  "type": "object",
  "required": [
    "status",
    "contract"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DRAFT.Default",
        "DRAFT.Reviewed",
        "DRAFT.Denied",
        "DRAFT.Pass",
        "APPROVED.Default",
        "APPROVED.Applying",
        "APPROVED.Application_Problems",
        "APPROVED.Unresolved",
        "APPROVED.Activate",
        "APPROVED.provisional",
        "RETIRED.Default",
        "RETIRED.Removable",
        "RETIRED.Waiting"
      ]
    },
    "contract": {
      "type": "string",
      "pattern": "^urn:[^:]+:consumer:contract:policy:(?:norm|gov|intent|arch|info|cntr|risk|supply|real|assure|ctrl|change|ops|record):[a-z0-9-]+:[a-z0-9-]+$"
    }
  },
  "additionalProperties": false
}
