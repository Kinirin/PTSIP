{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "version",
    "policy_class",
    "owner_policy_ref",
    "owner_section",
    "language_neutral",
    "program_language",
    "parameters",
    "protocol",
    "adapter_binding",
    "program",
    "language_contract",
    "module_digest_format"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ptsip-neutral-machine-module/v1"
    },
    "module_id": {
      "const": "urn:ptsip:support:root-family-projection:v1"
    },
    "version": {
      "const": "2.0"
    },
    "policy_class": {
      "const": "PTSIP_SUPPORT_FEATURE"
    },
    "owner_policy_ref": {
      "const": "SFP-CNTR-0004"
    },
    "owner_section": {
      "const": "unit_root_family_projection_module"
    },
    "language_neutral": {
      "const": true
    },
    "program_language": {
      "const": "PTSIP_JSON_PROGRAM_V1"
    },
    "parameters": {
      "const": {
        "policy_prefix": "SFP",
        "value_field": "authority_semantics",
        "owner_schema_version": "ptsip-support-root-family-policy/v1"
      }
    },
    "protocol": {
      "const": {
        "inputs": [
          "registry",
          "source",
          "read_record"
        ],
        "output": "HISTORICAL_SOURCE_RECORD",
        "record_digest": "SHA256_SORTED_COMPACT_UTF8_JSON_UNESCAPED",
        "identity_semantic_inheritance": "FORBIDDEN",
        "archive_runtime_fallback": "FORBIDDEN",
        "usage": "MIGRATION_HISTORY_AUDIT_ONLY",
        "current_root_dependency": "FORBIDDEN"
      }
    },
    "adapter_binding": {
      "const": {
        "path": "src/ptsip/governance/authority.py",
        "entrypoint": "project_source",
        "role": "INTERPRETER_ONLY"
      }
    },
    "program": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "language_contract": {
      "const": {
        "expression_operators": {
          "ref": {
            "arity": 0,
            "semantics": "ENV_JSON_POINTER_LOOKUP_MISSING_NULL"
          },
          "literal": {
            "arity": 0,
            "semantics": "JSON_VALUE_DEEP_COPY"
          },
          "eq": {
            "arity": 2,
            "semantics": "CANONICAL_JSON_VALUE_EQUALITY"
          },
          "all": {
            "arity": "VARIADIC",
            "semantics": "ALL_OPERANDS_ARE_JSON_TRUE"
          },
          "not": {
            "arity": 1,
            "semantics": "OPERAND_IS_NOT_JSON_TRUE"
          },
          "contains": {
            "arity": 2,
            "semantics": "JSON_ARRAY_CONTAINS_JSON_VALUE"
          },
          "get": {
            "arity": 2,
            "semantics": "OBJECT_KEY_LOOKUP_MISSING_NULL"
          },
          "concat": {
            "arity": "VARIADIC",
            "semantics": "STRING_CONCATENATION"
          },
          "starts_with": {
            "arity": 2,
            "semantics": "STRING_PREFIX_MATCH"
          },
          "pluck": {
            "arity": 2,
            "semantics": "ARRAY_OF_OBJECT_KEY_VALUES_NULL_INPUT_EMPTY_ARRAY"
          },
          "has_key": {
            "arity": 2,
            "semantics": "OBJECT_KEY_PRESENCE"
          },
          "pointer_nonoverlap": {
            "arity": 2,
            "semantics": "ABSOLUTE_JSON_POINTER_NO_EQUAL_ANCESTOR_DESCENDANT_IN_SEEN"
          },
          "pointer_first": {
            "arity": 1,
            "semantics": "FIRST_DECODED_RFC6901_POINTER_TOKEN"
          },
          "read_record": {
            "arity": 1,
            "semantics": "EXACT_CLASS_LOCAL_RELATIVE_POLICY_RECORD_NO_PATH_ESCAPE"
          },
          "record_digest": {
            "arity": 1,
            "semantics": "SHA256_SORTED_COMPACT_UTF8_JSON_UNESCAPED"
          }
        },
        "instruction_semantics": {
          "let": "DEEP_COPY_VALUE_TO_NAMED_ENVIRONMENT_SLOT",
          "assert": "FAIL_WITH_DECLARED_ERROR_UNLESS_PREDICATE_JSON_TRUE",
          "append": "APPEND_VALUE_TO_NAMED_ARRAY",
          "foreach": "EXECUTE_BODY_SERIAL_IN_ARRAY_ORDER_BINDING_NAMED_ITEM",
          "set_pointer": "SET_DEEP_COPY_VALUE_AT_DECODED_RFC6901_OBJECT_POINTER",
          "return": "RETURN_DEEP_COPY_VALUE"
        },
        "execution_order": "SERIAL",
        "unknown_operator": "FAIL_CLOSED",
        "embedded_implementation_language_source": "FORBIDDEN"
      }
    },
    "module_digest_format": {
      "const": "SHA256_UTF8_LF"
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "const": "ref"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "all",
                "not",
                "contains",
                "get",
                "concat",
                "starts_with",
                "pluck",
                "has_key",
                "pointer_nonoverlap",
                "pointer_first",
                "read_record",
                "record_digest"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "let",
            "assert",
            "append",
            "foreach",
            "set_pointer",
            "return"
          ]
        },
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/expression"
        },
        "predicate": {
          "$ref": "#/$defs/expression"
        },
        "error": {
          "type": "string"
        },
        "items": {
          "$ref": "#/$defs/expression"
        },
        "pointer": {
          "$ref": "#/$defs/expression"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
