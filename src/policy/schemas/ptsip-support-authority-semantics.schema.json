{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/docs/Support_policy/policy/schemas/ptsip-support-authority-semantics.schema.json",
  "title": "PTSIP Support Authority Semantics v1",
  "$defs": {
    "ROOT_FAMILY_V1": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "family_definition"
      ],
      "properties": {
        "family_definition": {
          "type": "object",
          "required": [
            "kernel_definitions"
          ],
          "properties": {
            "kernel_definitions": {
              "type": "array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^(?:unit_|semantic_unit_)[a-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "SFP_ARCH_0001_V1": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "family_definition",
        "engine_plane_boundary"
      ],
      "properties": {
        "family_definition": {
          "type": "object",
          "required": [
            "kernel_definitions"
          ],
          "properties": {
            "kernel_definitions": {
              "type": "array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "engine_plane_boundary": {
          "type": "object",
          "required": [
            "repository_local_root",
            "repository_local_state",
            "semantic_role_binding_source",
            "physical_path_name_is_semantic_role_authority",
            "executable_implementation_owner",
            "executable_source_copy_into_repository_engine_root",
            "shipped_repository_module",
            "shipped_engine_state_schema",
            "state_contract",
            "schema_contract",
            "runtime_activation"
          ],
          "properties": {
            "repository_local_root": {
              "const": ".ptsip/engine/"
            },
            "repository_local_state": {
              "const": ".ptsip/engine/state.json"
            },
            "semantic_role_binding_source": {
              "const": ".ptsip/index.json"
            },
            "physical_path_name_is_semantic_role_authority": {
              "const": false
            },
            "executable_implementation_owner": {
              "const": "INSTALLED_PTSIP_PACKAGE"
            },
            "executable_source_copy_into_repository_engine_root": {
              "const": "FORBIDDEN"
            },
            "shipped_repository_module": {
              "const": "src/ptsip/repository/namespace.py"
            },
            "shipped_engine_state_schema": {
              "const": "src/ptsip/repository/schemas/engine-state.schema.json"
            },
            "state_contract": {
              "const": "DEFERRED"
            },
            "schema_contract": {
              "const": "DEFERRED"
            },
            "runtime_activation": {
              "const": "DEFERRED"
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^(?:unit_|semantic_unit_)[a-z0-9_]+$": {}
      },
      "additionalProperties": false
    },
    "SFP_INFO_0004_V1": {
      "type": "object",
      "required": [
        "domain",
        "target",
        "independence",
        "approved_decisions",
        "invariants",
        "unresolved_decisions",
        "implementation_detail_authority",
        "family_definition"
      ],
      "properties": {
        "domain": {
          "const": "PROJECT_PROFILE_SOURCE_COMPOSITION"
        },
        "target": {
          "const": "CONSUMER_PROJECT_PROFILE"
        },
        "independence": {
          "type": "object",
          "minProperties": 1
        },
        "approved_decisions": {
          "type": "object",
          "minProperties": 1
        },
        "invariants": {
          "type": "object",
          "minProperties": 1
        },
        "unresolved_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resolved_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "selected_option", "approval_source", "decision_date"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "selected_option": {"type": "string", "minLength": 1},
              "approval_source": {"const": "USER_EXPLICIT"},
              "decision_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "resolution_scope": {"type": "string", "minLength": 1},
              "concrete_algorithm": {"type": "string", "minLength": 1},
              "policy_constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "machine_verification": {"type": "string", "minLength": 1},
              "actual_grouping_and_source_MUTATION": {"type": "string", "minLength": 1},
              "active_transition": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "implementation_detail_authority": {
          "const": "PLAN"
        },
        "family_definition": {
          "type": "object",
          "required": [
            "kernel_definitions"
          ],
          "properties": {
            "kernel_definitions": {
              "type": "array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SFP_INFO_0008_V1": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "family_definition",
        "engine_state_approved_direction",
        "engine_state_authority_boundaries",
        "engine_state_responsibility_partition",
        "engine_state_unresolved_policy_decisions",
        "engine_state_unresolved_plan_contract_details"
      ],
      "properties": {
        "family_definition": {
          "type": "object",
          "required": [
            "kernel_definitions"
          ],
          "properties": {
            "kernel_definitions": {
              "type": "array",
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "engine_state_approved_direction": {
          "type": "object",
          "minProperties": 1
        },
        "engine_state_authority_boundaries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "engine_state_responsibility_partition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "engine_state_unresolved_policy_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "engine_state_unresolved_plan_contract_details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^(?:unit_|semantic_unit_)[a-z0-9_]+$": {}
      },
      "additionalProperties": false
    }
  }
}
