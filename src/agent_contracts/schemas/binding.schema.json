{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ptsip-agent-binding/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "binding_id", "status", "contract_set_id", "active_specs", "active_operations", "active_vocabularies", "external_machine_contracts", "implementation_bindings"],
  "properties": {
    "format": {"const": "ptsip-agent-binding/v2"},
    "binding_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE", "CURRENT", "SUPERSEDED"]},
    "contract_set_id": {"const": "ptsip-agent-contracts"},
    "active_specs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "active_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "active_vocabularies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "external_machine_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "version", "package", "resource"],
        "properties": {
          "contract_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "resource": {"type": "string", "minLength": 1}
        }
      }
    },
    "implementation_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "python_modules"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "python_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "cli_command": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}