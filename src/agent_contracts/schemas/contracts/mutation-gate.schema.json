{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ptsip-agent-mutation-gate/v2",
  "type":"object","additionalProperties":false,
  "required":["format","gate_id","status","input_schema_ref","strategy","requirements"],
  "properties":{
    "format":{"const":"ptsip-agent-mutation-gate/v2"},
    "gate_id":{"type":"string","pattern":"^PTSIP-GATE-[A-Z0-9-]+$"},
    "status":{"enum":["CANDIDATE","CURRENT","SUPERSEDED"]},
    "input_schema_ref":{"type":"string","pattern":"^PTSIP-IO-[A-Z0-9-]+$"},
    "strategy":{"const":"ALL_REQUIRED"},
    "requirements":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["condition_ref","on_false","on_unknown"],"properties":{
      "condition_ref":{"type":"string","pattern":"^PTSIP-COND-[A-Z0-9-]+$"},
      "on_false":{"type":"string","minLength":1},"on_unknown":{"type":"string","minLength":1}
    }}}
  }
}
