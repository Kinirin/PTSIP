{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"ptsip-agent-vocabulary/v2",
  "type":"object","additionalProperties":false,
  "required":["format","vocabulary_id","status","domain","entries"],
  "properties":{"format":{"const":"ptsip-agent-vocabulary/v2"},"vocabulary_id":{"type":"string","minLength":1},
    "status":{"enum":["CANDIDATE","CURRENT","SUPERSEDED"]},"domain":{"type":"string","minLength":1},
    "entries":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["id","category","meaning"],"properties":{"id":{"type":"string","minLength":1},
        "category":{"type":"string","minLength":1},"meaning":{"type":"string","minLength":1}}}}
  }
}
