{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ptsip-agent-operation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "operation_id",
    "status",
    "rule_refs",
    "vocabulary_refs",
    "input_schema_ref",
    "output_schema_ref",
    "preconditions",
    "entry_step",
    "steps",
    "outcomes"
  ],
  "properties": {
    "format": {
      "const": "ptsip-agent-operation/v2"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^PTSIP-OP-[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "CURRENT",
        "SUPERSEDED"
      ]
    },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_schema_ref": {
      "type": "string",
      "pattern": "^PTSIP-IO-[A-Z0-9-]+$"
    },
    "output_schema_ref": {
      "type": "string",
      "pattern": "^PTSIP-IO-[A-Z0-9-]+$"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "entry_step": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/actionStep"
          },
          {
            "$ref": "#/$defs/conditionStep"
          }
        ]
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vocabulary_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PTSIP-VOCAB-[A-Z0-9-]+$"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_ref",
        "on_false",
        "on_unknown"
      ],
      "properties": {
        "condition_ref": {
          "type": "string",
          "pattern": "^PTSIP-COND-[A-Z0-9-]+$"
        },
        "on_false": {
          "type": "string",
          "minLength": 1
        },
        "on_unknown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\$(input|step:[A-Za-z0-9_-]+)#(/.*)?$"
      }
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_ref"
          ],
          "properties": {
            "step_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "output_bindings": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome_from"
          ],
          "properties": {
            "outcome_from": {
              "type": "string",
              "pattern": "^\\$step:[A-Za-z0-9_-]+#/.*$"
            }
          }
        }
      ]
    },
    "actionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "action_ref",
        "input_bindings",
        "on_success"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ACTION"
        },
        "action_ref": {
          "type": "string",
          "pattern": "^PTSIP-ACT-[A-Z0-9-]+$"
        },
        "input_bindings": {
          "$ref": "#/$defs/bindings"
        },
        "mutation_gate_ref": {
          "type": "string",
          "pattern": "^PTSIP-GATE-[A-Z0-9-]+$"
        },
        "mutation_gate_input_bindings": {
          "$ref": "#/$defs/bindings"
        },
        "on_success": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "conditionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "condition_ref",
        "input_bindings",
        "branches"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "CONDITION"
        },
        "condition_ref": {
          "type": "string",
          "pattern": "^PTSIP-COND-[A-Z0-9-]+$"
        },
        "input_bindings": {
          "$ref": "#/$defs/bindings"
        },
        "branches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ],
          "properties": {
            "TRUE": {
              "$ref": "#/$defs/transition"
            },
            "FALSE": {
              "$ref": "#/$defs/transition"
            },
            "UNKNOWN": {
              "$ref": "#/$defs/transition"
            }
          }
        }
      }
    }
  }
}
