{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ptsip-agent-condition/v2",
  "type":"object","additionalProperties":false,
  "required":["format","condition_id","status","input_schema_ref","evaluation"],
  "properties":{
    "format":{"const":"ptsip-agent-condition/v2"},
    "condition_id":{"type":"string","pattern":"^PTSIP-COND-[A-Z0-9-]+$"},
    "status":{"enum":["CANDIDATE","CURRENT","SUPERSEDED"]},
    "input_schema_ref":{"type":"string","pattern":"^PTSIP-IO-[A-Z0-9-]+$"},
    "evaluation":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["type","pointer","operator","expected","missing_result"],"properties":{
        "type":{"const":"FIELD_COMPARE"},"pointer":{"type":"string","pattern":"^/"},"operator":{"const":"EQ"},
        "expected":{"type":["string","number","boolean","null"]},"missing_result":{"const":"UNKNOWN"}
      }},
      {"type":"object","additionalProperties":false,"required":["type","condition_refs"],"properties":{
        "type":{"enum":["ALL_OF","ANY_OF"]},"condition_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^PTSIP-COND-[A-Z0-9-]+$"}}
      }},
      {"type":"object","additionalProperties":false,"required":["type","condition_ref"],"properties":{
        "type":{"const":"NOT"},"condition_ref":{"type":"string","pattern":"^PTSIP-COND-[A-Z0-9-]+$"}
      }},
      {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"BOUND_EVALUATOR"}}}
    ]}
  }
}
