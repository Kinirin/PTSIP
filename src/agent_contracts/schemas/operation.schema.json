{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ptsip-agent-operation/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "operation_id", "status", "rule_refs", "mutation", "preconditions", "steps", "outcomes"],
  "properties": {
    "format": {"const": "ptsip-agent-operation/v2"},
    "operation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["CANDIDATE", "CURRENT", "SUPERSEDED"]},
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "write_requires"],
      "properties": {
        "default": {"const": "READ_ONLY"},
        "write_requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "preconditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action_id"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "action_id": {"type": "string", "minLength": 1},
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "fail_closed_outcomes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}