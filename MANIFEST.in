prune src/tests
recursive-include src/policy *.yaml *.json
recursive-include src/ptsip/profiles *.ptsip.yaml
include src/ptsip/profiles/index.yaml
include registry/project-profile-contracts.yaml

recursive-include src/ptsip/engines *.json
prune src/ptsip/engines/context/target
prune src/ptsip/engines/storage/target
prune src/ptsip/engines/validation/target
prune src/ptsip/engines/discovery/target
prune src/ptsip/engines/planning/target
prune src/ptsip/engines/execution/target
prune src/ptsip/engines/projection/target
include registry/compile-sealed-rbac-registry-fields.json
recursive-include .ptsip/contracts/schemas/compile-sealed-rbac *.schema.json
recursive-include src/ptsip/specdata/compile-sealed-rbac *.schema.json
include src/ptsip/specdata/compile-sealed-rbac-registry-fields.json
include schemas/ptsip-profile-pp-2.00.candidate.schema.json
include src/ptsip/specdata/ptsip-profile-pp-2.00.candidate.schema.json
include .ptsip/contracts/schemas/compile-sealed-rbac/candidate-index.json
include src/ptsip/specdata/compile-sealed-rbac/candidate-index.json

# Only the current developer release module owns b5-derived PEP517 source builds.
include .ptsip/engine/developer/release/backend/ptsip_build_backend.py
include ptsip-build-source.json
recursive-include src/ptsip/engines Cargo.toml Cargo.lock *.rs *.yaml
