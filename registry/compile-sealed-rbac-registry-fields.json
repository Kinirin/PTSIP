{
  "contract_id": "PTSIP_COMPILE_SEALED_RBAC_CENTRAL_REGISTRY_FIELD_REQUIREMENTS",
  "contract_revision": 3,
  "policy_ref": "developer/policy/GOV/MPD-GOV-0001.yaml",
  "applies_when": "PROJECT_USES_COMPILE_SEALED_RBAC",
  "registry_root": ".ptsip/profiles/rbac/",
  "registry_model": "ONE_CENTRAL_REGISTRY",
  "purpose": "ID_AND_FILE_REFERENCE_DISCOVERY_NOT_CONTRACT_OWNERSHIP",
  "field_requirements": [
    {
      "path": "schema_version",
      "presence": "REQUIRED",
      "meaning": "REGISTRY_STRUCTURE_VERSION"
    },
    {
      "path": "entries",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_REGISTRATION_COLLECTION"
    },
    {
      "path": "entries[].id",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_IDENTITY"
    },
    {
      "path": "entries[].kind",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_KIND"
    },
    {
      "path": "entries[].resource",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_SOURCE_REFERENCE"
    },
    {
      "path": "entries[].revision",
      "presence": "CONDITIONAL",
      "condition": "UNRESOLVED",
      "meaning": "CONTRACT_REVISION_DISTINCTION_WHEN_APPLICABLE"
    },
    {
      "path": "metadata",
      "presence": "OPTIONAL",
      "meaning": "NONAUTHORITATIVE_DESCRIPTION_AND_DIAGNOSTICS"
    }
  ],
  "unresolved": [
    "REGISTRY_FILE_NAME",
    "REGISTRY_SERIALIZATION_FORMAT",
    "OTHER_FIELD_VALUE_TYPES_AND_CONSTRAINTS",
    "ENTRY_ID_UNIQUENESS_AND_IDENTITY_MATCH_RULES",
    "REVISION_CONDITIONAL_TRIGGER",
    "METADATA_INTERNAL_SHAPE",
    "REGISTRY_SCHEMA_AND_VALIDATOR_INTEGRATION",
    "SEAL_ACTIVATION_ARTIFACT_STORAGE_AND_LOOKUP"
  ],
  "assertions": {
    "does_not_embed_original_contract_definitions": true,
    "registry_existence_grants_approval": false,
    "registry_existence_activates_permissions": false,
    "independent_contract_ownership_preserved": true,
    "root_family_specific_duplication_required": false
  },
  "entry_kind_scope": {
    "allowed_semantic_kinds": [
      "RESPONSIBILITY",
      "CONDITION_ATOM",
      "PERMISSION_ATOM",
      "BINDING"
    ],
    "excluded_semantic_kinds": [
      "SEAL",
      "ACTIVATION"
    ],
    "serialized_kind_literals": [
      "RESPONSIBILITY",
      "CONDITION_ATOM",
      "PERMISSION_ATOM",
      "BINDING"
    ],
    "scope": "DECLARATIVE_CONTRACT_SOURCE_LOOKUP_ONLY",
    "type": "string",
    "case_sensitive": true
  },
  "separate_artifact_contracts": {
    "seal": {
      "schema_file": "sealed-contract.schema.json",
      "registry_entry_allowed": false,
      "artifact_plane": "SEPARATE_FROM_CENTRAL_DECLARATIVE_REGISTRY",
      "storage_ref": "UNRESOLVED",
      "lookup_contract": "UNRESOLVED"
    },
    "activation": {
      "schema_file": "activation.schema.json",
      "registry_entry_allowed": false,
      "artifact_plane": "SEPARATE_FROM_CENTRAL_DECLARATIVE_REGISTRY",
      "storage_ref": "UNRESOLVED",
      "lookup_contract": "UNRESOLVED"
    }
  },
  "entry_resource_reference": {
    "type": "string",
    "coordinate_system": "PROJECT_REPOSITORY_ROOT_RELATIVE",
    "canonical_prefix": ".ptsip/profiles/rbac/",
    "notation": "POSIX_SLASH_FILESYSTEM_PATH",
    "allowed_lowercase_suffixes": [
      ".json",
      ".yaml",
      ".yml"
    ],
    "nested_subdirectories_allowed": true,
    "filename_pattern": "NOT_CONSTRAINED_BY_ROOT_FAMILY",
    "lexical_requirements": {
      "nonempty_path_after_prefix": true,
      "no_leading_or_trailing_slash": true,
      "no_empty_segments": true,
      "reject_dot_or_dotdot_segments": true,
      "forbid_characters": [
        "\\",
        ":",
        "?",
        "#",
        "%"
      ],
      "forbid_control_characters": true,
      "absolute_paths_forbidden": true,
      "uri_scheme_forbidden": true
    },
    "filesystem_requirements": {
      "project_root_containment": true,
      "target_must_exist": true,
      "regular_file_only": true,
      "symlink_components_forbidden": true,
      "on_failure": "FAIL_CLOSED"
    },
    "authority": {
      "registry_reference_is_lookup_only": true,
      "content_must_be_verified_against_kind_schema_before_authorization": true,
      "binding_or_activation_cannot_be_inferred_from_file_existence": true
    }
  }
}
