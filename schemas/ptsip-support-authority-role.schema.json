          "preserve_equivalent_value_origins",
          "preserve_legacy_temporary_target_alias",
          "preserve_migration_engine_capability",
          "preserve_unresolved_analysis_state",
          "require_architectural_boundary",
          "require_async_work_after_required_work",
          "require_conditional_mutation",
          "require_deterministic_integrity_digest",
          "require_evidence_provenance",
          "require_exclusive_ownership_declaration_modes",
