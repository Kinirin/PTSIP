{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-governance-authority-subject-registry.schema.json",
  "title": "PTSIP Governance Authority Subject Registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "registry_role",
    "language_neutral",
    "authority_domains",
    "subject_types",
    "subject_identity_schemes",
    "repository_identity_schemes",
    "matching"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-governance-authority-subject-registry/v1"
    },
    "registry_role": {
      "const": "SUBJECT_APPLICABILITY_CATALOG_NOT_PROJECT_AUTHORITY"
    },
    "language_neutral": {
      "const": true
    },
    "frozen_by": {
      "type": "object",
      "required": [
        "type",
        "repository",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "GIT_COMMIT"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "authority_domains": {
      "const": [
        "PROJECT_GOVERNANCE"
      ]
    },
    "subject_types": {
      "const": [
        "GOVERNANCE_TOPIC"
      ]
    },
    "subject_identity_schemes": {
      "type": "object",
      "required": [
        "DECISION_TOPIC_ID"
      ],
      "properties": {
        "DECISION_TOPIC_ID": {
          "type": "object",
          "required": [
            "source_field",
            "registered_values"
          ],
          "properties": {
            "source_field": {
              "const": "decision.topic_id"
            },
            "registered_values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repository_identity_schemes": {
      "type": "object",
      "required": [
        "GITHUB_REPOSITORY_ID"
      ],
      "properties": {
        "GITHUB_REPOSITORY_ID": {
          "type": "object",
          "required": [
            "host_required",
            "repository_id_pattern"
          ],
          "properties": {
            "host_required": {
              "const": true
            },
            "repository_id_pattern": {
              "const": "^[1-9][0-9]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "current_repository_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "scheme",
          "host",
          "repository_id",
          "observed_slug",
          "slug_is_identity"
        ],
        "properties": {
          "scheme": {
            "const": "GITHUB_REPOSITORY_ID"
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "observed_slug": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "slug_is_identity": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "matching": {
      "type": "object",
      "required": [
        "order",
        "registered_machine_relationships",
        "relationship_must_be_registered_before_relaxed_match",
        "fuzzy_match",
        "ai_semantic_match"
      ],
      "properties": {
        "order": {
          "const": [
            "EXACT",
            "REGISTERED_MACHINE_RELATIONSHIP",
            "NO_MATCH"
          ]
        },
        "registered_machine_relationships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "relationship_id",
              "relationship_type",
              "authority_subject",
              "solve_subject"
            ],
            "properties": {
              "relationship_id": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9_.:-]*$"
              },
              "relationship_type": {
                "const": "AUTHORITY_SUBJECT_APPLIES_TO_SOLVE_SUBJECT"
              },
              "authority_subject": {
                "type": "object",
                "required": [
                  "scheme",
                  "value"
                ],
                "properties": {
                  "scheme": {
                    "const": "DECISION_TOPIC_ID"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                  }
                },
                "additionalProperties": false
              },
              "solve_subject": {
                "type": "object",
                "required": [
                  "scheme",
                  "value"
                ],
                "properties": {
                  "scheme": {
                    "const": "DECISION_TOPIC_ID"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "relationship_must_be_registered_before_relaxed_match": {
          "const": true
        },
        "fuzzy_match": {
          "const": "FORBIDDEN"
        },
        "ai_semantic_match": {
          "const": "FORBIDDEN"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
