{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-profile-pp-2.00.candidate.schema.json",
  "title": "PTSIP Project Profile pp.2.00 (non-normative RBAC implementation candidate)",
  "type": "object",
  "required": [
    "ptsip",
    "responsibility_map",
    "policies",
    "rbac"
  ],
  "properties": {
    "ptsip": {
      "type": "object",
      "required": [
        "version",
        "revision",
        "profile_role",
        "specification"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "pp.2.00",
          "description": "Candidate contract identity; pp.2.00 is NOT a current registered profile."
        },
        "specification": {
          "type": "object",
          "required": [
            "source",
            "revision"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute Specification source identity; Tool support is evaluated independently through Specification capability authority."
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Immutable Specification Git revision. This identity is independent from ptsip.revision, which is user-owned Project Profile lineage."
            }
          },
          "additionalProperties": false
        },
        "revision": {
          "type": "string",
          "pattern": "^Rev\\.[0-9]{4}$",
          "description": "User-owned authoritative Project Profile generation within one PP contract. Developer-distributed baselines begin at Rev.0001."
        },
        "profile_role": {
          "enum": [
            "PROJECT",
            "DISTRIBUTED_EXAMPLE"
          ],
          "description": "PROJECT is repository authority. DISTRIBUTED_EXAMPLE is non-authoritative and requires project-path materialization before use."
        },
        "rule_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.ptsip\\.yaml$",
          "description": "Optional, repository-local non-authoritative rule record profile linked from the selected Project Profile."
        }
      },
      "additionalProperties": false
    },
    "responsibility_map": {
      "$ref": "#/$defs/responsibilityMap"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "associated_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/associatedArtifact"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "component_dependency_policy": {
      "$ref": "#/$defs/componentDependencyPolicy"
    },
    "policies": {
      "type": "object",
      "required": [
        "product_to_nonproduct_runtime_dependency",
        "nonproduct_in_product_package",
        "independent_build_resolution"
      ],
      "properties": {
        "product_to_nonproduct_runtime_dependency": {
          "const": "deny"
        },
        "nonproduct_in_product_package": {
          "const": "deny"
        },
        "independent_build_resolution": {
          "const": "required"
        },
        "shared_executable_cross_lifecycle": {
          "const": "deny"
        },
        "neutral_contract_sharing": {
          "enum": [
            "allow",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Explicit project opt-in: must not be inferred from file existence."
        },
        "registry_ref": {
          "type": "string",
          "description": "Reference is ignored for authorization when enabled is false; path requirements apply when enabled is true."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "registry_ref"
            ],
            "properties": {
              "registry_ref": {
                "type": "string",
                "pattern": "^\\.ptsip/profiles/rbac/(?:(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1F\\x7F]+/)*(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1F\\x7F]+$"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "responsibility_map": {
            "properties": {
              "mode": {
                "const": "explicit"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "responsibility_map"
        ]
      },
      "then": {
        "required": [
          "components"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "responsibility_map": {
            "properties": {
              "mode": {
                "enum": [
                  "template",
                  "hybrid"
                ]
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "responsibility_map"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "components"
              ]
            },
            {
              "required": [
                "associated_artifacts"
              ]
            },
            {
              "required": [
                "relationships"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "component_dependency_policy"
        ]
      },
      "then": {
        "properties": {
          "responsibility_map": {
            "properties": {
              "mode": {
                "const": "explicit"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "components"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "selectorList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "templateRef": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "responsibilityMap": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "explicit"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "template"
          ],
          "properties": {
            "mode": {
              "const": "template"
            },
            "template": {
              "$ref": "#/$defs/templateRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "template",
            "overrides"
          ],
          "properties": {
            "mode": {
              "const": "hybrid"
            },
            "template": {
              "$ref": "#/$defs/templateRef"
            },
            "overrides": {
              "$ref": "#/$defs/hybridOverrides"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "hybridOverrides": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "remove_component_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "associated_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/associatedArtifact"
          }
        },
        "remove_associated_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "remove_relationship_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "include",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "classification": {
          "enum": [
            "PRODUCT",
            "DEVELOPMENT_TOOLING",
            "DELIVERY",
            "OPERATIONS",
            "NEUTRAL_CONTRACT"
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "IMPLEMENTATION",
              "VERIFICATION",
              "AUTOMATION",
              "CONFIGURATION",
              "DOCUMENTATION",
              "GOVERNANCE"
            ]
          },
          "uniqueItems": true
        },
        "include": {
          "$ref": "#/$defs/selectorList"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "shipped": {
          "type": "boolean",
          "description": "Whether the component is shipped as part of Product distribution scope."
        },
        "runtime_required": {
          "type": "boolean",
          "description": "Whether Product runtime operation requires this component as implementation."
        },
        "executable": {
          "type": "boolean"
        },
        "release_owner": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_owner": {
          "type": "string",
          "minLength": 1
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Legacy-compatible descriptive metadata; not a typed Responsibility Map edge."
        },
        "analysis_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Analysis metadata; not a typed Responsibility Map edge."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "DEVELOPMENT_TOOLING",
                  "DELIVERY",
                  "OPERATIONS"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "shipped": {
                "const": false
              },
              "runtime_required": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "NEUTRAL_CONTRACT"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "required": [
              "executable"
            ],
            "properties": {
              "executable": {
                "const": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "associatedArtifact": {
      "type": "object",
      "required": [
        "id",
        "anchor",
        "include",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "$ref": "#/$defs/id"
        },
        "include": {
          "$ref": "#/$defs/selectorList"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "IMPORTS",
            "LINKS",
            "LOADS",
            "INVOKES",
            "READS",
            "GENERATES",
            "BUILDS",
            "PACKAGES",
            "PUBLISHES",
            "DEPLOYS",
            "VERIFIES",
            "MANAGES",
            "DOCUMENTS",
            "SPECIFIES",
            "GOVERNS"
          ]
        }
      },
      "additionalProperties": false
    },
    "componentDependencyPolicy": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentDependencyRelation"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentDependencyRelation"
          }
        }
      },
      "additionalProperties": false
    },
    "componentDependencyRelation": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "DRAFT_NON_NORMATIVE: candidate extends pp.1.02 by explicit rbac.enabled / rbac.registry_ref only. No version activation, no approved migration contract, no authority or deployment. Additional pp.2.00 requirements are unresolved."
}
