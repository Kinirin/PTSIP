{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-governance-subject-binding.schema.json",
  "title": "PTSIP Governance Subject Binding v1",
  "type": "object",
  "required": [
    "authority_domain",
    "repository_binding",
    "subject_type",
    "subject_identity"
  ],
  "properties": {
    "authority_domain": {
      "const": "PROJECT_GOVERNANCE"
    },
    "repository_binding": {
      "type": "object",
      "required": [
        "scheme",
        "host",
        "repository_id"
      ],
      "properties": {
        "scheme": {
          "const": "GITHUB_REPOSITORY_ID"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "subject_type": {
      "const": "GOVERNANCE_TOPIC"
    },
    "subject_identity": {
      "type": "object",
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "const": "DECISION_TOPIC_ID"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
