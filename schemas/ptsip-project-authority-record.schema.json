{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kinirin/PTSIP/main/schemas/ptsip-project-authority-record.schema.json",
  "title": "PTSIP Project Authority Record v1",
  "type": "object",
  "required": [
    "schema_version",
    "authority_id",
    "authority_contract",
    "authority_semantics",
    "authority_role",
    "authority_provenance",
    "subject_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-project-authority-record/v1"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^ADR-[0-9]{4}$"
    },
    "authority_contract": {
      "type": "object",
      "required": [
        "authority_type",
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "authority_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "schema_id": {
          "type": "string",
          "pattern": "^ptsip\\.governance/[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "authority_semantics": {
      "type": "object",
      "minProperties": 1
    },
    "authority_role": {
      "$ref": "ptsip-governance-authority-role.schema.json"
    },
    "authority_provenance": {
      "type": "object",
      "required": [
        "source_type",
        "source_ref",
        "source_revision",
        "source_digest"
      ],
      "properties": {
        "source_type": {
          "const": "MACHINE_ADR"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^decisions/ADR-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.yaml$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "subject_binding": {
      "$ref": "ptsip-governance-subject-binding.schema.json"
    }
  },
  "additionalProperties": false
}
