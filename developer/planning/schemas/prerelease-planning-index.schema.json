{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer-prerelease-planning-index:v1alpha1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "plan_identity",
    "plan",
    "work_units",
    "execution_model"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-developer-prerelease-planning-index/v1alpha1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "plan_identity": {
      "type": "object",
      "required": ["resolved_plan_id", "plan_file_id", "version", "revision"],
      "properties": {
        "resolved_plan_id": {"type": "string", "minLength": 1},
        "plan_file_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "development_line",
        "prerelease",
        "integration_branch",
        "status",
        "approval",
        "implementation_authorization",
        "canonical_location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "development_line": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "prerelease": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:a|b|rc)[0-9]+$"
        },
        "integration_branch": {
          "type": "string",
          "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+(?:(?:a|b|rc)[0-9]+)?$"
        },
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "COMPLETE",
            "SUPERSEDED",
            "CANCELLED"
          ]
        },
        "approval": {
          "type": "object",
          "required": [
            "status",
            "approval_source"
          ],
          "properties": {
            "status": {
              "const": "APPROVED"
            },
            "approval_source": {
              "const": "USER_EXPLICIT"
            }
          }
        },
        "implementation_authorization": {
          "type": "object",
          "required": [
            "status",
            "authorization_source"
          ],
          "properties": {
            "status": {
              "enum": [
                "AUTHORIZED",
                "COMPLETE"
              ]
            },
            "authorization_source": {
              "const": "USER_EXPLICIT"
            }
          }
        },
        "canonical_location": {
          "type": "string",
          "pattern": "^developer/planning/[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]+\\.[0-9]+\\.[0-9]+(?:a|b|rc)[0-9]+/index\\.yaml$"
        }
      }
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "title",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WU-[0-9]{2}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^WU-[0-9]{2}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "execution_model": {
      "type": "object",
      "required": [
        "current_gate",
        "dependency_order"
      ],
      "properties": {
        "current_gate": {
          "type": "string",
          "pattern": "^WU-[0-9]{2}$"
        },
        "dependency_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^WU-[0-9]{2}$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
