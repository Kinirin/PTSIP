{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_class", "projection_authority", "tasks"],
  "properties": {
    "schema_version": {"const": "ptsip-implementation-workflows/v1"},
    "artifact_class": {"const": "DEVELOPER_EXECUTION_PROJECTION"},
    "projection_authority": {"const": false},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch", "scope", "operation", "edit_targets", "acceptance_vectors", "verification", "desired_test_component"],
        "properties": {
          "branch": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "operation": {"enum": ["READ", "MODIFY", "PLAN", "VERIFY", "RELEASE"]},
          "edit_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "selector"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "selector": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {"enum": ["PYTHON_FUNCTION", "PYTHON_METHOD", "CLI_COMMAND_BRANCH", "PYTHON_MODULE"]},
                    "name": {"type": "string"},
                    "class": {"type": "string"},
                    "method": {"type": "string"},
                    "command": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "acceptance_vectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "preconditions", "action", "expected"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "preconditions": {"type": "object"},
                "action": {"type": "string", "minLength": 1},
                "expected": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "object",
            "required": ["baseline_pytest_nodes", "required_new_pytest_nodes", "regression_pytest_targets", "full_command"],
            "properties": {
              "baseline_pytest_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "required_new_pytest_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "regression_pytest_targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "full_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "desired_test_component": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
