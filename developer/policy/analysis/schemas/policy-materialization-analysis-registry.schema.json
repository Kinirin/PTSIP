{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:policy-materialization-analysis-registry:v3",
  "title": "Registry-First Policy Analysis Registry v3",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_class",
    "records",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "developer-policy-materialization-analysis-registry/v3"
    },
    "artifact_class": {
      "const": "PTSIP_POLICY_MATERIALIZATION_ANALYSIS_REGISTRY"
    },
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "analysis_id",
          "analysis_ref",
          "subject_type",
          "subject_id",
          "analysis_kind"
        ],
        "properties": {
          "analysis_id": {
            "type": "string",
            "pattern": "^PRA-[0-9]{4}$"
          },
          "analysis_ref": {
            "type": "string",
            "pattern": "^developer/policy/analysis/records/PRA-[0-9]{4}\\.yaml$"
          },
          "subject_type": {
            "enum": ["POLICY", "FAMILY", "WORK_UNIT"]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "analysis_kind": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"subject_type": {"const": "POLICY"}}, "required": ["subject_type"]},
            "then": {"properties": {"subject_id": {"pattern": "^MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4})$"}}}
          },
          {
            "if": {"properties": {"subject_type": {"const": "FAMILY"}}, "required": ["subject_type"]},
            "then": {"properties": {"subject_id": {"enum": ["SPEC", "PLAN", "WORK", "VERI", "MIGR", "RELS"]}}}
          },
          {
            "if": {"properties": {"subject_type": {"const": "WORK_UNIT"}}, "required": ["subject_type"]},
            "then": {"properties": {"subject_id": {"pattern": "^WU-[0-9]{2,}$"}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "policy_class",
          "family",
          "analysis_id",
          "group_id"
        ],
        "properties": {
          "policy_class": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/developer_policy_class"},
          "family": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/responsibility_family"},
          "policy_id": {
            "type": "string",
            "pattern": "^MPD-(?:SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}$"
          },
          "analysis_id": {
            "type": "string",
            "pattern": "^PRA-[0-9]{4}$"
          },
          "group_id": {
            "type": "string",
            "pattern": "^G[0-9]{2,}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
