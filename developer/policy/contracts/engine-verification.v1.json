{
  "schema_version": "ptsip-engine-verification/v1",
  "operation": "VERIFY",
  "authority_refs": {
    "execution": "developer/policy/CTRL/MPD-CTRL-0001.yaml#rules.release_execution_suspension.engine_verification_only",
    "verification": "developer/policy/ASSURE/MPD-ASSURE-0001.yaml#rules.engine_verification_only"
  },
  "approval_ref": "developer/policy/approvals/MPA-20261013-ENGINE-GATE-AND-CACHE.yaml",
  "workflow_ref": ".github/workflows/tooling-release.yml",
  "result_scope": "ENGINE_VERIFICATION_ONLY",
  "engine_registry_ref": "src/ptsip/engines/index.json",
  "installation_contract_ref": "src/ptsip/engines/contracts/installation-plan.json",
  "engines": ["context", "storage", "validation", "discovery", "planning", "execution", "projection"],
  "platforms": ["windows-x64", "linux-x64", "macos-arm64"],
  "required_checks": [
    "LOCKED_SELECTED_ENGINE_RUST_TESTS",
    "LOCKED_SELECTED_ENGINE_NATIVE_BUILD",
    "EXACT_SOURCE_SHA_AND_CLEAN_TRACKED_SOURCE",
    "REGISTERED_ENGINE_ID_VERSION_BINDING_AND_HOST",
    "WHEEL_MEMBERS_RECORD_AND_ARTIFACT_DIGESTS",
    "RECEIPT_TAMPER_AND_SOURCE_MISMATCH_REJECTION",
    "ISOLATED_NO_DEPENDENCY_CONSUMER_INSTALL_AND_NATIVE_MANIFEST"
  ],
  "implementation": {
    "wheel_module": ".github/checks/release/engine-verification",
    "wheel_command": ["go", "run", "./cmd/engine-wheel"],
    "verifier_module": "developer/tests",
    "verifier_selection": "^TestIndependentEngineWheel/<selected-engine>$"
  },
  "tool_verification": "NOT_IMPLEMENTED",
  "profile_verification": "NOT_IMPLEMENTED",
  "package_verification": "NOT_IMPLEMENTED",
  "release_gate": "ENABLED",
  "release_gate_scope": "SELECTED_ENGINE_VERIFICATION",
  "gate_required_checks": ["CANONICAL_ADMISSION", "ALL_SELECTED_PLATFORM_JOBS_SUCCESS", "ONE_UNEXPIRED_ARTIFACT_PER_SELECTED_ENGINE_PLATFORM", "EXACT_WORKFLOW_RUN_SOURCE_SHA"],
  "rust_cache": {
    "role": "NON_AUTHORITATIVE_BUILD_ACCELERATION",
    "partition": "ENGINE_RUNNER_NATIVE_TARGET_AND_RUST_COMPILER",
    "source_change_restore": "SAME_ENGINE_TOOLCHAIN_AND_DEPENDENCY_KEY_ONLY",
    "cached_result_is_verification_evidence": false,
    "rerun_locked_test_build_and_artifact_verification": true
  },
  "publication_authority": "NOT_GRANTED_BY_VERIFICATION",
  "legacy_verification_fallback": false,
  "engine_pass_is_release_authorization": false,
  "real_consumer_installation_or_activation": "NOT_AUTHORIZED"
}
