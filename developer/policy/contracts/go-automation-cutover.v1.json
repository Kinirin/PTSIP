    "ORIGINAL_RESPONSIBILITY_LIFECYCLE_PRESERVED",
    "ALL_OPERATIONAL_DEVELOPER_POLICY_REFERENCES_ARE_DIRECT_ROOT_REFERENCES",
    "NO_DEVELOPER_LEGACY_POLICY_FILES_OR_RUNTIME_PROJECTIONS",
    "GO_VERIFICATION_AND_PRESERVED_REGRESSION_COVERAGE_PASS"
