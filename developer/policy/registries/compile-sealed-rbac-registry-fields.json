  "unresolved": [
    "REGISTRY_FILE_NAME",
    "REGISTRY_SERIALIZATION_FORMAT",
    "FIELD_VALUE_TYPES_AND_CONSTRAINTS",
    "ENTRIES_KIND_VALUE_SET",
    "ENTRY_ID_UNIQUENESS_AND_RESOURCE_REFERENCE_RULES",
    "REVISION_CONDITIONAL_TRIGGER",
    "METADATA_INTERNAL_SHAPE",
    "REGISTRY_SCHEMA_AND_VALIDATOR_INTEGRATION"
  ],
  "assertions": {
    "does_not_embed_original_contract_definitions": true,
    "registry_existence_grants_approval": false,
    "registry_existence_activates_permissions": false,
    "independent_contract_ownership_preserved": true,
    "root_family_specific_duplication_required": false
  }
