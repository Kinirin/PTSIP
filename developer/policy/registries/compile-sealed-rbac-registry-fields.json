{
  "contract_id": "PTSIP_COMPILE_SEALED_RBAC_CENTRAL_REGISTRY_FIELD_REQUIREMENTS",
  "contract_revision": 1,
  "policy_ref": "developer/policy/GOV/MPD-GOV-0001.yaml",
  "applies_when": "PROJECT_USES_COMPILE_SEALED_RBAC",
  "registry_root": ".ptsip/profiles/rbac/",
  "registry_model": "ONE_CENTRAL_REGISTRY",
  "purpose": "ID_AND_FILE_REFERENCE_DISCOVERY_NOT_CONTRACT_OWNERSHIP",
  "field_requirements": [
    {
      "path": "schema_version",
      "presence": "REQUIRED",
      "meaning": "REGISTRY_STRUCTURE_VERSION"
    },
    {
      "path": "entries",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_REGISTRATION_COLLECTION"
    },
    {
      "path": "entries[].id",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_IDENTITY"
    },
    {
      "path": "entries[].kind",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_KIND"
    },
    {
      "path": "entries[].resource",
      "presence": "REQUIRED",
      "meaning": "INDEPENDENT_CONTRACT_SOURCE_REFERENCE"
    },
    {
      "path": "entries[].revision",
      "presence": "CONDITIONAL",
      "condition": "UNRESOLVED",
      "meaning": "CONTRACT_REVISION_DISTINCTION_WHEN_APPLICABLE"
    },
    {
      "path": "metadata",
      "presence": "OPTIONAL",
      "meaning": "NONAUTHORITATIVE_DESCRIPTION_AND_DIAGNOSTICS"
    }
