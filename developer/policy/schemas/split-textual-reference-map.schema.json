{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:split-textual-reference-map:v1",
  "title": "PTSIP Temporary Split Textual Reference Map v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "temporary",
    "source_revision",
    "status",
    "application_gate",
    "cleanup",
    "entries",
    "boundary_findings"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-split-textual-reference-map/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "temporary": {
      "const": true
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "DRY_RUN_READY",
        "APPROVED_FOR_APPLY",
        "APPLIED"
      ]
    },
    "application_gate": {
      "type": "object",
      "required": [
        "all_target_policies_materialized",
        "all_expected_lines_match",
        "boundary_findings_resolved"
      ],
      "properties": {
        "all_target_policies_materialized": {
          "type": "boolean"
        },
        "all_expected_lines_match": {
          "type": "boolean"
        },
        "boundary_findings_resolved": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "delete_after_successful_apply",
        "requires_post_apply_zero_split_reference_scan"
      ],
      "properties": {
        "delete_after_successful_apply": {
          "const": true
        },
        "requires_post_apply_zero_split_reference_scan": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file_path",
          "line",
          "source_adr",
          "expected_line",
          "expected_reference",
          "occurrence_on_line",
          "resolution",
          "selected_target",
          "replacement_form"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TMP-SPLIT-[0-9]{3}$"
          },
          "file_path": {
            "type": "string",
            "pattern": "^.+\\.md$"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "source_adr": {
            "enum": [
              "ADR-0003",
              "ADR-0005",
              "ADR-0011",
              "ADR-0017",
              "ADR-0021",
              "ADR-0023"
            ]
          },
          "expected_line": {
            "type": "string",
            "minLength": 1
          },
          "expected_reference": {
            "type": "string",
            "minLength": 1
          },
          "occurrence_on_line": {
            "type": "integer",
            "minimum": 1
          },
          "resolution": {
            "enum": [
              "SFP_ONLY",
              "MPD_ONLY",
              "BOTH",
              "REMOVE_REFERENCE"
            ]
          },
          "selected_target": {
            "type": "string",
            "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
          },
          "replacement_form": {
            "enum": [
              "POLICY_ID",
              "POLICY_PATH"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "boundary_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file_path",
          "line",
          "source_adr",
          "target_policy",
          "problem",
          "required_action",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BOUNDARY-[0-9]{3}$"
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "source_adr": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          },
          "target_policy": {
            "type": "string",
            "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "enum": [
              "REMOVE_NORMATIVE_AUTHORITY_REFERENCE",
              "MANUAL_REVIEW"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
