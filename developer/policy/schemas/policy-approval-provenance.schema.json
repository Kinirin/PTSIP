{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-approval-provenance:v1",
  "title": "PTSIP Developer Policy Approval Provenance v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-approval-provenance/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "approval": {
      "type": "object",
      "required": [
        "approval_id",
        "decision",
        "source_kind",
        "decision_source",
        "approval_scope",
        "target_status",
        "implementation_authorized",
        "policy_content_review_scope",
        "recorded_at"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^MPA-[A-Za-z0-9._-]+$"
        },
        "decision": {
          "const": "APPROVED"
        },
        "source_kind": {
          "enum": [
            "PROJECT_OWNER_DIRECT_INSTRUCTION",
            "PROJECT_OWNER_REPOSITORY_RECORD"
          ]
        },
        "decision_source": {
          "const": "USER_EXPLICIT"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_scope": {
          "enum": [
            "DRAFT_CREATION",
            "TEMPORARY_DIRECTION_AND_IMPLEMENTATION",
            "FINAL_POLICY"
          ]
        },
        "target_status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "ACTIVE",
            "SUPERSEDED",
            "RETIRED"
          ]
        },
        "implementation_authorized": {
          "type": "boolean"
        },
        "policy_content_review_scope": {
          "enum": [
            "DIRECTION",
            "FULL"
          ]
        },
        "requested_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4})$"
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "conflict_resolution": {
          "oneOf": [
            {
              "enum": [
                "RECONCILE",
                "KEEP_LATEST",
                "KEEP_PRIOR"
              ]
            },
            {
              "type": "object",
              "required": [
                "strategy"
              ],
              "additionalProperties": false,
              "properties": {
                "strategy": {
                  "enum": [
                    "RECONCILE",
                    "KEEP_LATEST",
                    "KEEP_PRIOR"
                  ]
                },
                "prior_approval_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "previous_engine_version_owner_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "superseded_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "replacement_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "preserved_rules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "branch_creation_authorized": {
          "const": false
        },
        "existing_common_engine_plan_mutation_authorized": {
          "const": false
        },
        "common_engine_plan_mutation_authorized": {
          "const": false
        },
        "developer_tool_migration_authorized": {
          "const": false
        },
        "preserved_consumer_engine_state_policy": {
          "const": "SFP-ARCH-0001#authority_semantics.engine_plane_boundary"
        },
        "approved_developer_implementation_target": {
          "const": ".ptsip/engine/developer/"
        },
        "affected_policy_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:SFP|MPD)-(?:[A-Z]+-)?[0-9]{4}$"
          }
        },
        "correction": {
          "const": "REMOVE_POLICY_EXECUTION_ORDER_AND_DEFER_PRIORITY_TO_WU_PLAN"
        },
        "policy_may_define_durable_safety_preconditions": {
          "const": true
        },
        "work_unit_creation_authorized": {
          "const": false
        },
        "work_unit_priority_assignment_authorized": {
          "const": false
        },
        "target_substatus": {
          "type": "string"
        },
        "approved_direction": {
          "const": "FULL_INDEPENDENT_RELEASE_VERIFICATION_SCOPE"
        },
        "required_check_details": {
          "const": "UNRESOLVED"
        },
        "successor_verification_contract": {
          "const": "UNRESOLVED"
        },
        "publication_reactivation": {
          "const": "NOT_AUTHORIZED"
        },
        "existing_release_execution_suspension": {
          "const": "PRESERVED"
        },
        "existing_component_release_independence": {
          "const": "PRESERVED"
        },
        "existing_required_verification": {
          "const": "PRESERVED"
        },
        "scope_registry_ref": {
          "const": ".github/checks/release/release-contract.json"
        },
        "scope": {
          "const": "SUCCESSOR_RELEASE_VERIFICATION_DIRECTION_ONLY"
        },
        "successor_policy_content": {
          "const": "UNRESOLVED"
        },
        "current_release_execution_suspension": {
          "const": "PRESERVED"
        },
        "component_scope": {
          "const": [
            "TOOL",
            "PROFILE",
            "CONTEXT",
            "STORAGE",
            "VALIDATION",
            "DISCOVERY",
            "PLANNING",
            "EXECUTION",
            "PROJECTION",
            "PACKAGE"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
