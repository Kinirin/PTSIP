{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-relation-migration:v1",
  "title": "PTSIP Legacy ADR Policy Relation Migration v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "temporary",
    "source_revision",
    "source_relation_count",
    "boundary_rules",
    "relations",
    "materialization"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-relation-migration/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "temporary": {
      "const": true
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_relation_count": {
      "const": 5
    },
    "boundary_rules": {
      "type": "object",
      "required": [
        "SFP_TO_SFP",
        "MPD_TO_MPD",
        "MPD_TO_SFP",
        "SFP_TO_MPD"
      ],
      "properties": {
        "SFP_TO_SFP": {
          "const": "ALLOWED"
        },
        "MPD_TO_MPD": {
          "const": "ALLOWED"
        },
        "MPD_TO_SFP": {
          "const": "ALLOWED"
        },
        "SFP_TO_MPD": {
          "const": "FORBIDDEN"
        }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "migration_id",
          "source_relation",
          "projected_edges",
          "projection_basis"
        ],
        "properties": {
          "migration_id": {
            "type": "string",
            "pattern": "^REL-[0-9]{3}$"
          },
          "source_relation": {
            "type": "object",
            "required": [
              "source_adr",
              "relation",
              "target_adr",
              "scope"
            ],
            "properties": {
              "source_adr": {
                "type": "string",
                "pattern": "^ADR-[0-9]{4}$"
              },
              "relation": {
                "enum": [
                  "depends_on",
                  "amends",
                  "extends",
                  "supersedes"
                ]
              },
              "target_adr": {
                "type": "string",
                "pattern": "^ADR-[0-9]{4}$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "projected_edges": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "source_policy",
                "relation",
                "target_policy",
                "scope"
              ],
              "properties": {
                "source_policy": {
                  "type": "string",
                  "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
                },
                "relation": {
                  "enum": [
                    "depends_on",
                    "amends",
                    "extends",
                    "supersedes"
                  ]
                },
                "target_policy": {
                  "type": "string",
                  "pattern": "^(?:SFP|MPD)-[0-9]{4}$"
                },
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "projection_basis": {
            "enum": [
              "UNIQUE_TO_UNIQUE",
              "SPLIT_EXPLICIT_SCOPE_ROUTE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "materialization": {
      "type": "object",
      "required": [
        "write_into_target_policy_relations",
        "generic_relation_inference_after_migration",
        "delete_manifest_after_verified_materialization"
      ],
      "properties": {
        "write_into_target_policy_relations": {
          "const": true
        },
        "generic_relation_inference_after_migration": {
          "const": "FORBIDDEN"
        },
        "delete_manifest_after_verified_materialization": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
