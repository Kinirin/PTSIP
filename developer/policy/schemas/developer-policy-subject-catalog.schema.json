{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:subject-catalog-schema:v1",
  "type": "object",
  "required": ["schema_version", "artifact_class", "registry_role", "language_neutral", "subject_identity_schemes", "repository_identity_schemes", "current_repository_bindings", "matching"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/subject_schema_version"},
    "artifact_class": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/subject_artifact_class"},
    "registry_role": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/subject_registry_role"},
    "language_neutral": {"type": "boolean"},
    "subject_identity_schemes": {
      "type": "object", "required": ["MANAGEMENT_POLICY_ID"], "additionalProperties": false,
      "properties": {
        "MANAGEMENT_POLICY_ID": {
          "type": "object", "required": ["source_field", "registered_values"], "additionalProperties": false,
          "properties": {
            "source_field": {"const": "policy.id"},
            "registered_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/policy_id"}}
          }
        }
      }
    },
    "repository_identity_schemes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "current_repository_bindings": {"type": "array", "items": {"type": "object"}},
    "matching": {
      "type": "object",
      "required": ["order", "registered_machine_relationships", "relationship_must_be_registered_before_relaxed_match", "fuzzy_match", "ai_semantic_match"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "registered_machine_relationships": {"type": "array", "items": {"type": "object"}},
        "relationship_must_be_registered_before_relaxed_match": {"type": "boolean"},
        "fuzzy_match": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/forbidden_subject_match"},
        "ai_semantic_match": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/forbidden_subject_match"}
      }
    }
  }
}
