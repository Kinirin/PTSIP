{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-resolver-bindings:v1",
  "title": "PTSIP Developer Policy Resolver Bindings v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "resolver_id",
    "operation_vocabulary",
    "scope_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-resolver-bindings/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "resolver_id": {
      "const": "POLICY_RESOLVER_V1"
    },
    "operation_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["READ", "MODIFY", "PLAN", "VERIFY", "RELEASE"]
      }
    },
    "scope_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/scopeBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "policyRef": {
      "type": "object",
      "required": ["policy_id", "sections"],
      "properties": {
        "policy_id": {
          "type": "string",
          "pattern": "^MPD-[0-9]{4}$"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "policyRefList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policyRef"
      }
    },
    "scopeBinding": {
      "type": "object",
      "required": ["default_refs"],
      "properties": {
        "default_refs": {
          "$ref": "#/$defs/policyRefList"
        },
        "operations": {
          "type": "object",
          "propertyNames": {
            "enum": ["READ", "MODIFY", "PLAN", "VERIFY", "RELEASE"]
          },
          "additionalProperties": {
            "$ref": "#/$defs/policyRefList"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
