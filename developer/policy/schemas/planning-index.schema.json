{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer-planning-index:v1",
  "title": "PTSIP Developer Planning Version Index v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "plan",
    "work_units"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-developer-planning-index/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "plan": {
      "type": "object",
      "required": [
        "plan_version",
        "revision",
        "integration_branch",
        "classification",
        "status",
        "control_plane",
        "current_gate"
      ],
      "properties": {
        "plan_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "integration_branch": {
          "type": "string",
          "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "classification": {
          "enum": [
            "CORE/RELEASE-BLOCKING",
            "CORE",
            "DEVELOPMENT",
            "OPTIONAL"
          ]
        },
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "BLOCKED",
            "COMPLETE",
            "SUPERSEDED",
            "CANCELLED"
          ]
        },
        "control_plane": {
          "type": "string",
          "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
        },
        "current_gate": {
          "type": "string",
          "pattern": "^WU-[0-9]{2}(?:-P[0-9]{2})?$"
        }
      },
      "additionalProperties": false
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lifecycle",
          "approval",
          "implementation_authorization",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WU-[0-9]{2}$"
          },
          "path": {
            "type": "string",
            "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/WU-[0-9]{2}/WU-[0-9]{2}\\.yaml$"
          },
          "lifecycle": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_CREATED",
                  "DRAFT",
                  "ACTIVE",
                  "BLOCKED",
                  "COMPLETE",
                  "SUPERSEDED",
                  "CANCELLED"
                ]
              }
            },
            "additionalProperties": false
          },
          "approval": {
            "type": "object",
            "required": [
              "status",
              "inherited_from"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_REQUIRED",
                  "PENDING",
                  "APPROVED",
                  "REJECTED"
                ]
              },
              "inherited_from": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "implementation_authorization": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "NOT_AUTHORIZED",
                  "HOLD_NOT_AUTHORIZED",
                  "AUTHORIZED",
                  "COMPLETE"
                ]
              }
            },
            "additionalProperties": false
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WU-[0-9]{2}$"
            }
          },
          "completion_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "result"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "GIT_COMMIT",
                    "TEST",
                    "MACHINE_VALIDATION"
                  ]
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "PASS",
                    "RECORDED",
                    "COMPLETE"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "properties": {
                    "status": {
                      "const": "COMPLETE"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "completion_evidence"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "responsibility_routing": {
      "type": "object",
      "required": [
        "model",
        "canonical_plan",
        "canonical_plan_section",
        "branch_creation_parent",
        "dependency_bearing_convergence",
        "independent_leaf_work_units",
        "rules"
      ],
      "properties": {
        "model": {
          "const": "PARALLEL_DEPENDENCY_EXTRACTION"
        },
        "canonical_plan": {
          "type": "string",
          "pattern": "^planning/[0-9]+\\.[0-9]+\\.[0-9]+\\.md$"
        },
        "canonical_plan_section": {
          "type": "string",
          "minLength": 1
        },
        "branch_creation_parent": {
          "type": "string",
          "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "dependency_bearing_convergence": {
          "type": "object",
          "required": [
            "id",
            "responsibility",
            "expected_depends_on"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^WU-[0-9]{2}$"
            },
            "responsibility": {
              "type": "string",
              "minLength": 1
            },
            "expected_depends_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^WU-[0-9]{2}$"
              }
            }
          },
          "additionalProperties": false
        },
        "independent_leaf_work_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "branch",
              "responsibility",
              "forbidden_dependencies"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^WU-[0-9]{2}$"
              },
              "branch": {
                "type": "string",
                "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+-WU-[0-9]{2}$"
              },
              "responsibility": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_dependencies": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^WU-[0-9]{2}$"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "object",
          "required": [
            "dependency_bearing_work_routes_to_convergence",
            "independent_leafs_must_have_empty_depends_on",
            "leafs_must_not_depend_on_each_other",
            "leaf_planning_owned_by_parent"
          ],
          "properties": {
            "dependency_bearing_work_routes_to_convergence": {
              "const": true
            },
            "independent_leafs_must_have_empty_depends_on": {
              "const": true
            },
            "leafs_must_not_depend_on_each_other": {
              "const": true
            },
            "leaf_planning_owned_by_parent": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "entry_resolution": {
      "type": "object",
      "required": [
        "root_index",
        "resolver_module",
        "match_mode",
        "unknown_branch_behavior",
        "branch_change_requires_reresolution"
      ],
      "properties": {
        "root_index": {
          "const": "docs/planning/index.yaml"
        },
        "resolver_module": {
          "const": "developer.automation.planning_entry_resolver"
        },
        "match_mode": {
          "const": "EXACT_BRANCH"
        },
        "unknown_branch_behavior": {
          "const": "FAIL_CLOSED"
        },
        "branch_change_requires_reresolution": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
