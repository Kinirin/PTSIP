{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer-planning-root:v1",
  "title": "PTSIP Developer Planning Root Index v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-developer-planning-root/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "plan_version",
          "path",
          "status",
          "integration_branch"
        ],
        "properties": {
          "plan_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "COMPLETE",
              "SUPERSEDED",
              "CANCELLED"
            ]
          },
          "integration_branch": {
            "type": "string",
            "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "entry_routing": {
            "type": "object",
            "required": [
              "model",
              "canonical_plan",
              "responsibility_control_plane",
              "branch_creation_parent",
              "dependency_bearing_convergence",
              "independent_leaf_work_units",
              "resolver",
              "branch_entrypoints"
            ],
            "properties": {
              "model": {
                "const": "PARALLEL_DEPENDENCY_EXTRACTION"
              },
              "canonical_plan": {
                "type": "string",
                "pattern": "^planning/[0-9]+\\.[0-9]+\\.[0-9]+\\.md$"
              },
              "responsibility_control_plane": {
                "type": "string",
                "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
              },
              "branch_creation_parent": {
                "type": "string",
                "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "dependency_bearing_convergence": {
                "type": "object",
                "required": [
                  "id",
                  "responsibility"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^WU-[0-9]{2}$"
                  },
                  "responsibility": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "independent_leaf_work_units": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "branch",
                    "responsibility"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^WU-[0-9]{2}$"
                    },
                    "branch": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+-WU-[0-9]{2}$"
                    },
                    "responsibility": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "resolver": {
                "type": "object",
                "required": [
                  "module",
                  "command",
                  "branch_source",
                  "match_mode",
                  "unmatched_behavior",
                  "ambiguous_behavior"
                ],
                "properties": {
                  "module": {
                    "const": "developer.automation.planning_entry_resolver"
                  },
                  "command": {
                    "const": "python -m developer.automation.planning_entry_resolver"
                  },
                  "branch_source": {
                    "const": "GIT_CURRENT_BRANCH"
                  },
                  "match_mode": {
                    "const": "EXACT_BRANCH"
                  },
                  "unmatched_behavior": {
                    "const": "FAIL_CLOSED"
                  },
                  "ambiguous_behavior": {
                    "const": "FAIL_CLOSED"
                  }
                },
                "additionalProperties": false
              },
              "branch_entrypoints": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "branch",
                    "entry_document",
                    "role"
                  ],
                  "properties": {
                    "branch": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+(?:-WU-[0-9]{2})?$"
                    },
                    "entry_document": {
                      "type": "string",
                      "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/(?:index|WU-[0-9]{2}/WU-[0-9]{2})\\.yaml$"
                    },
                    "role": {
                      "enum": [
                        "INTEGRATION_CONTROL_PLANE",
                        "INDEPENDENT_LEAF"
                      ]
                    },
                    "work_unit": {
                      "type": "string",
                      "pattern": "^WU-[0-9]{2}$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "role": {
                            "const": "INDEPENDENT_LEAF"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "work_unit"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "role": {
                            "const": "INTEGRATION_CONTROL_PLANE"
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "required": [
                            "work_unit"
                          ]
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
