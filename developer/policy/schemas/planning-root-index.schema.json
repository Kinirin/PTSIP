{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer-planning-root:v1",
  "title": "PTSIP Developer Planning Root Index v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-developer-planning-root/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "plan_version",
          "path",
          "status",
          "integration_branch"
        ],
        "properties": {
          "plan_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "COMPLETE",
              "SUPERSEDED",
              "CANCELLED"
            ]
          },
          "integration_branch": {
            "type": "string",
            "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "entry_routing": {
            "type": "object",
            "required": [
              "model",
              "canonical_plan",
              "responsibility_control_plane",
              "branch_creation_parent",
              "dependency_bearing_convergence",
              "independent_leaf_work_units",
              "resolver",
              "merge_reconciliation",
              "branch_entrypoints"
            ],
            "properties": {
              "model": {
                "const": "PARALLEL_DEPENDENCY_EXTRACTION"
              },
              "canonical_plan": {
                "type": "string",
                "pattern": "^planning/[0-9]+\\.[0-9]+\\.[0-9]+\\.md$"
              },
              "responsibility_control_plane": {
                "type": "string",
                "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
              },
              "branch_creation_parent": {
                "type": "string",
                "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "dependency_bearing_convergence": {
                "type": "object",
                "required": [
                  "id",
                  "responsibility"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^WU-[0-9]{2}$"
                  },
                  "responsibility": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "independent_leaf_work_units": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "branch",
                    "responsibility"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^WU-[0-9]{2}$"
                    },
                    "branch": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+-WU-[0-9]{2}$"
                    },
                    "responsibility": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "resolver": {
                "type": "object",
                "required": [
                  "module",
                  "command",
                  "branch_source",
                  "match_mode",
                  "unmatched_behavior",
                  "ambiguous_behavior"
                ],
                "properties": {
                  "module": {
                    "const": "developer.automation.planning_entry_resolver"
                  },
                  "command": {
                    "const": "python -m developer.automation.planning_entry_resolver"
                  },
                  "branch_source": {
                    "const": "GIT_CURRENT_BRANCH"
                  },
                  "match_mode": {
                    "const": "EXACT_BRANCH"
                  },
                  "unmatched_behavior": {
                    "const": "FAIL_CLOSED"
                  },
                  "ambiguous_behavior": {
                    "const": "FAIL_CLOSED"
                  }
                },
                "additionalProperties": false
              },
              "merge_reconciliation": {
                "type": "object",
                "required": [
                  "module",
                  "reconcile_command",
                  "merge_command",
                  "target_branch",
                  "state_source",
                  "leaf_shared_index_mutation",
                  "merged_leaf_entrypoint_state",
                  "unfinished_merged_leaf_continuation",
                  "gate_policy"
                ],
                "properties": {
                  "module": {
                    "const": "developer.automation.planning_merge_reconciler"
                  },
                  "reconcile_command": {
                    "const": "python -m developer.automation.planning_merge_reconciler"
                  },
                  "merge_command": {
                    "const": "python -m developer.automation.planning_leaf_merge"
                  },
                  "target_branch": {
                    "type": "string",
                    "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  "state_source": {
                    "const": "WORK_UNIT_DOCUMENTS"
                  },
                  "leaf_shared_index_mutation": {
                    "const": "FORBIDDEN"
                  },
                  "merged_leaf_entrypoint_state": {
                    "const": "MERGED"
                  },
                  "unfinished_merged_leaf_continuation": {
                    "const": "INTEGRATION_BRANCH"
                  },
                  "gate_policy": {
                    "type": "object",
                    "required": [
                      "preserve_nonterminal_current_gate",
                      "merged_unfinished_leaf_after_gate_closure",
                      "integrated_unfinished_leaf_before_unmerged_leaf",
                      "unmerged_leaf_order",
                      "fallback"
                    ],
                    "properties": {
                      "preserve_nonterminal_current_gate": {
                        "const": true
                      },
                      "merged_unfinished_leaf_after_gate_closure": {
                        "const": true
                      },
                      "integrated_unfinished_leaf_before_unmerged_leaf": {
                        "const": true
                      },
                      "unmerged_leaf_order": {
                        "const": "DECLARATION_ORDER"
                      },
                      "fallback": {
                        "const": "FIRST_DEPENDENCY_SATISFIED_NONTERMINAL_WU"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "branch_entrypoints": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "branch",
                    "entry_document",
                    "role",
                    "state"
                  ],
                  "properties": {
                    "branch": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+(?:-WU-[0-9]{2})?$"
                    },
                    "entry_document": {
                      "type": "string",
                      "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/(?:index|WU-[0-9]{2}/WU-[0-9]{2})\\.yaml$"
                    },
                    "role": {
                      "enum": [
                        "INTEGRATION_CONTROL_PLANE",
                        "INDEPENDENT_LEAF"
                      ]
                    },
                    "state": {
                      "enum": [
                        "ACTIVE",
                        "MERGED"
                      ]
                    },
                    "work_unit": {
                      "type": "string",
                      "pattern": "^WU-[0-9]{2}$"
                    },
                    "merged_into": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "role": {
                            "const": "INDEPENDENT_LEAF"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "work_unit"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "role": {
                            "const": "INTEGRATION_CONTROL_PLANE"
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "required": [
                            "work_unit"
                          ]
                        },
                        "properties": {
                          "state": {
                            "const": "ACTIVE"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "const": "MERGED"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "merged_into"
                        ],
                        "properties": {
                          "role": {
                            "const": "INDEPENDENT_LEAF"
                          }
                        }
                      }
                    }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "materialized_state": {
            "type": "object",
            "required": [
              "mode",
              "source",
              "generated_by",
              "current_gate",
              "current_gate_document",
              "work_units"
            ],
            "properties": {
              "mode": {
                "const": "DERIVED_CACHE"
              },
              "source": {
                "type": "string",
                "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/index\\.yaml$"
              },
              "generated_by": {
                "const": "developer.automation.planning_merge_reconciler"
              },
              "current_gate": {
                "type": "string",
                "pattern": "^WU-[0-9]{2}(?:-P[0-9]{2})?$"
              },
              "current_gate_document": {
                "type": "string",
                "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/WU-[0-9]{2}/WU-[0-9]{2}(?:-P[0-9]{2})?\\.yaml$"
              },
              "work_units": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "lifecycle_status",
                    "implementation_authorization_status",
                    "execution_location"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^WU-[0-9]{2}$"
                    },
                    "lifecycle_status": {
                      "enum": [
                        "NOT_CREATED",
                        "DRAFT",
                        "ACTIVE",
                        "BLOCKED",
                        "COMPLETE",
                        "SUPERSEDED",
                        "CANCELLED"
                      ]
                    },
                    "implementation_authorization_status": {
                      "enum": [
                        "NOT_AUTHORIZED",
                        "HOLD_NOT_AUTHORIZED",
                        "AUTHORIZED",
                        "COMPLETE"
                      ]
                    },
                    "execution_location": {
                      "enum": [
                        "INTEGRATION_BRANCH",
                        "LEAF_BRANCH",
                        "NOT_CREATED"
                      ]
                    },
                    "branch": {
                      "type": "string",
                      "pattern": "^dev/[0-9]+\\.[0-9]+\\.[0-9]+(?:-WU-[0-9]{2})?$"
                    },
                    "entry_document": {
                      "type": "string",
                      "pattern": "^docs/planning/[0-9]+\\.[0-9]+\\.[0-9]+/WU-[0-9]{2}/WU-[0-9]{2}\\.yaml$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
