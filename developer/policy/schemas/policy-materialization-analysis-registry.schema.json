{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:policy-materialization-analysis-registry:v2",
  "title": "Class-aware Policy Materialization Analysis Registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_class",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "developer-policy-materialization-analysis-registry/v2"
    },
    "artifact_class": {
      "const": "PTSIP_POLICY_MATERIALIZATION_ANALYSIS_REGISTRY"
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "policy_class",
          "family",
          "analysis_ref",
          "analysis_id",
          "group_id"
        ],
        "properties": {
          "policy_class": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/developer_policy_class"},
          "family": {"$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/responsibility_family"},
          "policy_id": {
            "type": "string",
            "pattern": "^MPD-(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}$"
          },
          "analysis_ref": {
            "type": "string",
            "pattern": "^developer/policy/analysis/[A-Za-z0-9._-]+\\.yaml$"
          },
          "analysis_id": {
            "type": "string",
            "pattern": "^PRA-[A-Za-z0-9._-]+$"
          },
          "group_id": {
            "type": "string",
            "pattern": "^G[0-9]{2,}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
