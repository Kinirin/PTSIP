{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-materialization-analysis-registry:v1",
  "title": "PTSIP Policy Materialization Analysis Registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_class",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-materialization-analysis-registry/v1"
    },
    "artifact_class": {
      "const": "PTSIP_POLICY_MATERIALIZATION_ANALYSIS_REGISTRY"
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "analysis_ref",
          "analysis_id",
          "group_id"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^MPD-(?:SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}$"
          },
          "analysis_ref": {
            "type": "string",
            "pattern": "^developer/policy/analysis/[A-Za-z0-9._-]+\\.yaml$"
          },
          "analysis_id": {
            "type": "string",
            "pattern": "^PRA-[A-Za-z0-9._-]+$"
          },
          "group_id": {
            "type": "string",
            "pattern": "^G[0-9]{2,}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
