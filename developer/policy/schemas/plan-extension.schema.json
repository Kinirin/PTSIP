{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer-plan-extension:v1",
  "title": "PTSIP Developer Plan Extension v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "plan_version",
    "extension",
    "approval",
    "implementation_authorization",
    "depends_on"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-plan-extension/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "extension": {
      "type": "object",
      "required": [
        "id",
        "parent",
        "title",
        "classification",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WU-[0-9]{2}-P[0-9]{2}$"
        },
        "parent": {
          "type": "string",
          "pattern": "^WU-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "CORE/RELEASE-BLOCKING",
            "CORE",
            "DEVELOPMENT",
            "OPTIONAL"
          ]
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "DRAFT",
                "ACTIVE",
                "BLOCKED",
                "COMPLETE",
                "SUPERSEDED",
                "CANCELLED"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "implementation_authorization": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_AUTHORIZED",
            "HOLD_NOT_AUTHORIZED",
            "AUTHORIZED",
            "COMPLETE"
          ]
        }
      },
      "additionalProperties": false
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^WU-[0-9]{2}(?:-P[0-9]{2})?$"
      }
    },
    "completion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "result"
        ],
        "properties": {
          "type": {
            "enum": [
              "GIT_COMMIT",
              "TEST",
              "MACHINE_VALIDATION"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "PASS",
              "RECORDED",
              "COMPLETE"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
