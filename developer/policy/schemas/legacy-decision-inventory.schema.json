{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:legacy-decision-inventory:v1",
  "title": "PTSIP Legacy ADR to MPD/SFP Inventory v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "source",
    "classification_vocabulary",
    "projection_rules",
    "summary",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-legacy-decision-inventory/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "source": {
      "type": "object",
      "required": [
        "directory",
        "index",
        "record_count",
        "id_pattern"
      ],
      "properties": {
        "directory": {
          "const": "decisions/"
        },
        "index": {
          "const": "decisions/INDEX.yaml"
        },
        "record_count": {
          "const": 23
        },
        "id_pattern": {
          "const": "^ADR-[0-9]{4}$"
        }
      },
      "additionalProperties": false
    },
    "classification_vocabulary": {
      "const": [
        "MPD",
        "SFP",
        "SPLIT",
        "RETIRE"
      ]
    },
    "projection_rules": {
      "type": "object",
      "required": [
        "SFP",
        "MPD",
        "SPLIT",
        "RETIRE"
      ],
      "properties": {
        "SFP": {
          "type": "object"
        },
        "MPD": {
          "type": "object"
        },
        "SPLIT": {
          "type": "object"
        },
        "RETIRE": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "MPD",
        "SFP",
        "SPLIT",
        "RETIRE",
        "total",
        "planned_sfp_targets",
        "planned_mpd_targets",
        "retired_fragments"
      ],
      "properties": {
        "MPD": {
          "type": "integer",
          "minimum": 0
        },
        "SFP": {
          "type": "integer",
          "minimum": 0
        },
        "SPLIT": {
          "type": "integer",
          "minimum": 0
        },
        "RETIRE": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "const": 23
        },
        "planned_sfp_targets": {
          "type": "integer",
          "minimum": 0
        },
        "planned_mpd_targets": {
          "type": "integer",
          "minimum": 0
        },
        "retired_fragments": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "topic_id",
          "source_path",
          "classification",
          "classification_basis",
          "outputs"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          },
          "topic_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "source_path": {
            "type": "string",
            "pattern": "^decisions/ADR-[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*\\.yaml$"
          },
          "classification": {
            "enum": [
              "MPD",
              "SFP",
              "SPLIT",
              "RETIRE"
            ]
          },
          "classification_basis": {
            "enum": [
              "CONSUMER_OR_INSTALLED_TOOL_CONTRACT",
              "PTSIP_REPOSITORY_DEVELOPMENT_CONTROL",
              "MIXED_SUPPORT_AND_DEVELOPER_OR_HISTORICAL_SEMANTICS",
              "HISTORICAL_ONLY_NO_CURRENT_POLICY_OWNER"
            ]
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "target_class",
                "disposition",
                "semantic_scope"
              ],
              "properties": {
                "target_class": {
                  "enum": [
                    "MPD",
                    "SFP",
                    "RETIRE"
                  ]
                },
                "target_id": {
                  "type": "string",
                  "pattern": "^(?:MPD|SFP)-[0-9]{4}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "MATERIALIZE",
                    "RETIRE_FRAGMENT"
                  ]
                },
                "semantic_scope": {
                  "type": "object",
                  "required": [
                    "mode"
                  ],
                  "properties": {
                    "mode": {
                      "enum": [
                        "FULL_AUTHORITY_SEMANTICS",
                        "SELECTED_AUTHORITY_SEMANTICS_FIELDS"
                      ]
                    },
                    "include_fields": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "MATERIALIZE"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "target_id",
                      "title"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "RETIRE_FRAGMENT"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "target_class": {
                        "const": "RETIRE"
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
