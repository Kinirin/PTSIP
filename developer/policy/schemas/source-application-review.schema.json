{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:source-application-review:v1",
  "title": "PTSIP Governance Source Application Review v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_class",
    "authority",
    "canonical_source_registry_ref",
    "policy_query_list",
    "artifact_review_list",
    "excluded_existing_source_semantics",
    "migration_order"
  ],
  "properties": {
    "schema_version": {"const": "ptsip-source-application-review/v1"},
    "artifact_class": {"const": "PTSIP_DEVELOPER_POLICY_SOURCE_REVIEW"},
    "authority": {"const": false},
    "canonical_source_registry_ref": {"const": "developer/policy/registries/governance-source-registry.yaml"},
    "policy_query_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["policy_id", "expected_status", "sections", "reason"],
        "properties": {
          "policy_id": {"type": "string", "pattern": "^MPD-[0-9]{4}$"},
          "expected_status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED", "RETIRED"]},
          "sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}
          },
          "review_role": {"enum": ["REVIEW_ONLY_NOT_AUTHORITY"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "artifact_review_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "classification", "target_role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "classification": {
            "enum": [
              "MUST_ADOPT_GOVERNANCE_SOURCE_CONSTANT",
              "REVIEW_BEFORE_SOURCE_ADOPTION",
              "GOVERNANCE_SOURCE_ADOPTED",
              "SOURCE_KEY_HAS_NON_GOVERNANCE_MEANING"
            ]
          },
          "target_role": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "excluded_existing_source_semantics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location", "meaning"],
        "properties": {
          "location": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "migration_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
    }
  },
  "additionalProperties": false
}
