{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:root-family-policy:v1",
  "title": "PTSIP Developer Root Family Policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "responsibility_family",
    "policy",
    "authority_subject",
    "exclusive_kernel",
    "rules",
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ptsip-developer-root-family-policy/v1"
    },
    "policy_class": {
      "const": "PTSIP_DEVELOPER_POLICY"
    },
    "responsibility_family": {
      "enum": [
        "NORM",
        "GOV",
        "INTENT",
        "ARCH",
        "INFO",
        "CNTR",
        "RISK",
        "SUPPLY",
        "REAL",
        "ASSURE",
        "CTRL",
        "CHANGE",
        "OPS",
        "RECORD"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MPD-(NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "ACTIVE",
            "SUPERSEDED",
            "RETIRED"
          ]
        }
      }
    },
    "authority_subject": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exclusive_kernel": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1
    },
    "relations": {
      "type": "object",
      "required": [
        "supersedes",
        "amends",
        "extends",
        "depends_on"
      ],
      "additionalProperties": false,
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "target_status",
        "state",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "target_status": {
          "const": "ACTIVE"
        },
        "state": {
          "enum": [
            "PENDING",
            "READY",
            "COMPLETE"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "state",
              "next_action"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^TR-[0-9]{3,}$"
              },
              "type": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "state": {
                "enum": [
                  "OPEN",
                  "IN_PROGRESS",
                  "SATISFIED",
                  "FAILED"
                ]
              },
              "refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "next_action": {
                "type": "object",
                "required": [
                  "action",
                  "execution",
                  "completion_check"
                ],
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "execution": {
                    "enum": [
                      "PARALLEL_ALLOWED",
                      "SERIAL_REQUIRED",
                      "OWNER_DECISION_REQUIRED"
                    ]
                  },
                  "target_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "after": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^TR-[0-9]{3,}$"
                    }
                  },
                  "completion_check": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "status": {
                "const": "DRAFT"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "version": {
                "pattern": "^0\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "required": [
          "transition"
        ],
        "properties": {
          "policy": {
            "properties": {
              "version": {
                "pattern": "^1\\.(0|[1-9][0-9]*)$"
              }
            }
          },
          "transition": {
            "properties": {
              "state": {
                "enum": [
                  "PENDING",
                  "READY"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "status": {
                "const": "ACTIVE"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "required": [
          "transition"
        ],
        "properties": {
          "policy": {
            "properties": {
              "version": {
                "pattern": "^(?:[2-9]|[1-9][0-9]+)\\.(0|[1-9][0-9]*)$"
              }
            }
          },
          "transition": {
            "properties": {
              "state": {
                "const": "COMPLETE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy": {
            "properties": {
              "status": {
                "enum": [
                  "SUPERSEDED",
                  "RETIRED"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "version": {
                "pattern": "^(?:[2-9]|[1-9][0-9]+)\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    }
  ]
}
