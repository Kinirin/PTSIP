{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:management-policy:v2",
  "title": "Class-aware Developer Management Policy v2",
  "type": "object",
  "required": [
    "schema_version",
    "policy_class",
    "policy",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "ptsip-developer-policy/v1",
        "developer-policy/v2"
      ]
    },
    "policy_class": {
      "$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/policy_class"
    },
    "policy": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "status",
        "substatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/policy_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "urn:ptsip:policy:policy-status-constant:v1#/$defs/status"
        },
        "version": {
          "$ref": "urn:developer-policy:lifecycle-version:v1#/$defs/policy_version"
        },
        "substatus": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "urn:ptsip:policy:policy-status-constant:v1#/$defs/policy_fields"
        },
        {
          "$ref": "urn:developer-policy:lifecycle-version:v1#/$defs/policy_fields"
        }
      ]
    },
    "rules": {
      "type": "object",
      "minProperties": 1
    },
    "automation": {
      "type": "object"
    },
    "migration": {
      "type": "object"
    },
    "relations": {
      "type": "object",
      "required": [
        "supersedes",
        "amends",
        "extends",
        "depends_on"
      ],
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "amends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "type": "string",
                "pattern": "^(?:SFP-(?:[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4})|MPD-(?:[0-9]{4}|BOUND-[0-9]{4}|(?:NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD|SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4}))$"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "$ref": "#/$defs/transition"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "transition": {
      "type": "object",
      "required": [
        "target_status",
        "state",
        "requirements"
      ],
      "properties": {
        "target_status": {
          "const": "APPROVED"
        },
        "state": {
          "enum": [
            "PENDING",
            "READY",
            "COMPLETE"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transition_requirement"
          }
        },
        "target_substatus": {
          "$ref": "urn:ptsip:policy:policy-status-constant:v1#/$defs/approved_substatus"
        }
      },
      "additionalProperties": false
    },
    "transition_requirement": {
      "type": "object",
      "required": [
        "id",
        "type",
        "state",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TR-[0-9]{3,}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "state": {
          "enum": [
            "OPEN",
            "IN_PROGRESS",
            "SATISFIED",
            "FAILED"
          ]
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_action": {
          "$ref": "#/$defs/transition_next_action"
        }
      },
      "additionalProperties": false
    },
    "transition_next_action": {
      "type": "object",
      "required": [
        "action",
        "execution",
        "completion_check"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "execution": {
          "enum": [
            "PARALLEL_ALLOWED",
            "SERIAL_REQUIRED",
            "OWNER_DECISION_REQUIRED"
          ]
        },
        "target_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TR-[0-9]{3,}$"
          }
        },
        "completion_check": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "ptsip-developer-policy/v1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "policy_class": {
            "enum": [
              "PTSIP_DEVELOPER_POLICY",
              "PTSIP_BOUND_POLICY"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_class": {
            "const": "VPMS_DEVELOPER_POLICY"
          }
        },
        "required": [
          "policy_class"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "developer-policy/v2"
          },
          "policy": {
            "properties": {
              "id": {
                "$ref": "urn:developer-policy:catalog-contracts:v1#/$defs/root_family_policy_id"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_class": {
            "const": "PTSIP_BOUND_POLICY"
          }
        },
        "required": [
          "policy_class"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "id": {
                "pattern": "^MPD-BOUND-[0-9]{4}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_class": {
            "const": "PTSIP_DEVELOPER_POLICY"
          }
        },
        "required": [
          "policy_class"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "id": {
                "pattern": "^MPD-(?:[0-9]{4}|(?:SPEC|PLAN|WORK|VERI|MIGR|RELS)-[0-9]{4})$"
              }
            }
          }
        }
      }
    }
  ]
}
