{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Status-version:v1",
  "type": "object",
  "required": [
    "contract",
    "version"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^urn:[^:]+:contract:policy:(?:norm|gov|intent|arch|info|cntr|risk|supply|real|assure|ctrl|change|ops|record):[a-z0-9-]+:[a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    }
  }
}
