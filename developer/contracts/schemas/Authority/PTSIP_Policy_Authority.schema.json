{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:Policy_Authority:v1",
  "title": "PTSIP Policy authority",
  "type": "object",
  "required": [
    "authority_Identity"
  ],
  "properties": {
    "authority_Identity": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1
        },
        "Authority_Major_Category": {
          "$ref": "urn:ptsip:policy:authority:major-category:v1"
        }
      }
    }
  }
}
