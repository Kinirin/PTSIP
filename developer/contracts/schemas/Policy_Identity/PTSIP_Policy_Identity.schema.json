{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy:identity:v2",
  "title": "PTSIP Policy Identity",
  "type": "object",
  "required": [
    "id",
    "policy_kind",
    "root_family"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "policy_kind": {
      "type": "string",
      "enum": [
        "PTSIP_DEVELOPER_POLICY",
        "PTSIP_SUPPORT_FEATURE"
      ]
    },
    "root_family": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "Keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "x-ptsip-contract-binding": {
    "routing": "developer/contracts/routing/policy_routes.json",
    "root_family": "developer/contracts/identity/root_family.json"
  }
}
