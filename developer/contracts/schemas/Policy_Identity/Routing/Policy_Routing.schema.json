{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:policy-routing:v2",
  "title": "PTSIP Policy Routing Contract",
  "description": "Validates explicit routes from policy_kind and root_family to policy output directories and schema references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_sources",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-routing/v2"
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "urn:ptsip:identity:policy-kind:v1"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "urn:ptsip:identity:root-family:v1"
        },
        "additionalProperties": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "identity_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_kind",
        "root_family"
      ],
      "properties": {
        "root_family": {
          "$ref": "#/$defs/repositoryFile"
        },
        "policy_kind": {
          "$ref": "#/$defs/repositoryFile"
        }
      }
    }
  },
  "$defs": {
    "schemaReference": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference"
    },
    "repositoryDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "schema_refs"
      ],
      "properties": {
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory"
          ],
          "properties": {
            "directory": {
              "$ref": "#/$defs/repositoryDirectory"
            }
          }
        },
        "schema_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public",
            "authority",
            "rules"
          ],
          "properties": {
            "public": {
              "$ref": "#/$defs/schemaReference"
            },
            "authority": {
              "$ref": "#/$defs/schemaReference"
            },
            "rules": {
              "$ref": "#/$defs/schemaReference"
            }
          }
        }
      }
    },
    "repositoryFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+\\.json$"
    }
  }
}
