{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:developer:test-mode-registry:structure:v1",
  "title": "PTSIP repository test mode execution registry structure",
  "type": "object",
  "required": [
    "version",
    "defaults",
    "groups",
    "modes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "3.0"
    },
    "defaults": {
      "type": "object",
      "required": [
        "workflow_mode"
      ],
      "properties": {
        "workflow_mode": {
          "$ref": "#/$defs/id"
        },
        "release_targets": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "component_ref",
          "execution"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "component_ref": {
            "$ref": "#/$defs/id"
          },
          "execution": {
            "type": "object",
            "properties": {
              "pytest": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/path"
                }
              },
              "go": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/path"
                }
              },
              "contract_ref": {
                "$ref": "#/$defs/path"
              },
              "runner_ref": {
                "$ref": "#/$defs/path"
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "pytest"
                ]
              },
              {
                "required": [
                  "go"
                ]
              },
              {
                "required": [
                  "contract_ref",
                  "runner_ref"
                ]
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
