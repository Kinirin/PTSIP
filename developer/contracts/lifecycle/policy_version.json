{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:lifecycle-version:v1",
  "schema_version": "developer-policy-lifecycle-version/v1",
  "artifact_class": "DEVELOPER_POLICY_LIFECYCLE_VERSION_CONTRACT",
  "authority": {
    "primary_owner_family": "GOV",
    "approval_ref": "developer/policy/approvals/MPA-20261013-LIFECYCLE-STAGE-DECOUPLING-KEEP-LATEST.yaml",
    "policy_scope": "PTSIP_DEVELOPER_POLICY",
    "repository_path_scope": "developer/**",
    "excluded_paths": [
      "developer/policy/legacy/**"
    ],
    "policy_authority_ref": "developer/policy/registries/family-schema-rebuild.json#/lifecycle_contract_usage/decisions",
    "successor_governance_policy": "PENDING_INDEPENDENT_GOV_DECLARATION",
    "retired_GOV_normative_fallback": false
  },
  "definition_state": "DEFINED",
  "type": "object",
  "required": [
    "status",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/policy_version"
    }
  },
  "$defs": {
    "policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "policy_fields": {
      "type": "object",
      "required": [
        "status",
        "version"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/policy_version"
        }
      }
    }
  },
  "format": "MAJOR.MINOR",
  "initial_value": "0.0",
  "status_major_rules": {
    "RETIRED": {
      "version_effect": "PRESERVE_PREVIOUS_VERSION"
    }
  },
  "status_contract_ref": "developer/contracts/lifecycle/policy_status.json",
  "validation": {
    "status_and_substatus": "VALIDATE_WITH_GOV_STATUS_CONTRACT",
    "version_and_major_stage": "VALIDATE_VERSION_SYNTAX_ONLY",
    "status_inference_from_version": false,
    "version_inference_from_status": false,
    "status_version_major_relation": "NONE"
  },
  "source_boundary": {
    "decision_source": "USER_EXPLICIT",
    "withdrawn_rule": "ACTIVE=2.x",
    "approved_activate_is_top_level_active": false,
    "legacy_policy_reuse": false,
    "legacy_source_fallback": false,
    "removed_numeric_method": [
      "DRAFT=0.x",
      "APPROVED>=1.x"
    ],
    "policy_authority_ref": "developer/policy/approvals/MPA-20261013-LIFECYCLE-STAGE-DECOUPLING-KEEP-LATEST.yaml"
  },
  "existing_validator_cutover": "GOV_CONTRACT_ADMITTED",
  "$ref": "#/$defs/policy_fields"
}
