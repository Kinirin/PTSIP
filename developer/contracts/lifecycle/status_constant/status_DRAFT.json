{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:contract:constant:status_draft:v1",
  "title": "PTSIP DRAFT Status Contract",
  "schema_version": "ptsip-lifecycle-status-constant/v1",
  "type": "object",
  "required": [
    "status",
    "substatus"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "DRAFT"
    },
    "substatus": {
      "type": "string",
      "enum": [
        "Default",
        "Reviewed",
        "Denied",
        "Pass"
      ]
    }
  }
}
