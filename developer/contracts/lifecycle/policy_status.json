{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:developer-policy:lifecycle-status:v1",
  "schema_version": "developer-policy-lifecycle-status/v1",
  "artifact_class": "DEVELOPER_POLICY_LIFECYCLE_STATUS_CONTRACT",
  "authority": {
    "primary_owner_family": "GOV",
    "approval_ref": "developer/policy/approvals/MPA-20261013-LIFECYCLE-STAGE-DECOUPLING-KEEP-LATEST.yaml",
    "policy_scope": "PTSIP_DEVELOPER_POLICY",
    "repository_path_scope": "developer/**",
    "excluded_paths": [
      "developer/policy/legacy/**"
    ],
    "policy_authority_ref": "developer/policy/registries/family-schema-rebuild.json#/lifecycle_contract_usage/decisions",
    "successor_governance_policy": "PENDING_INDEPENDENT_GOV_DECLARATION",
    "retired_GOV_normative_fallback": false
  },
  "type": "object",
  "required": [
    "status",
    "substatus"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/status"
    },
    "substatus": {
      "type": "string"
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "RETIRED"
      ]
    },
    "policy_fields": {
      "type": "object",
      "required": [
        "status",
        "substatus"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "substatus": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "DRAFT"
            },
            "substatus": {
              "enum": [
                "Default",
                "Reviewed",
                "Denied",
                "Pass"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "APPROVED"
            },
            "substatus": {
              "enum": [
                "Default",
                "Applying",
                "Application_Problems",
                "Unresolved",
                "Activate"
              ]
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "RETIRED"
            },
            "substatus": {
              "enum": [
                "Default",
                "Removable",
                "Waiting"
              ]
            }
          }
        }
      ]
    },
    "approved_substatus": {
      "enum": [
        "Default",
        "Applying",
        "Application_Problems",
        "Unresolved",
        "Activate"
      ]
    }
  },
  "meanings": {
    "DRAFT": {
      "Default": "Pre-review draft.",
      "Reviewed": "Reviewed by the user; final response is pending.",
      "Denied": "Draft denied by the user.",
      "Pass": "Draft review marker; no automatic approval or status change."
    },
    "APPROVED": {
      "Default": "Explicitly approved policy; not equivalent to DRAFT.Pass.",
      "Applying": "Implementation in accordance with the approved policy is in progress.",
      "Application_Problems": "A policy conflict occurred during application; return to Default when the conflict is resolved.",
      "Unresolved": "Policy implementation is incomplete.",
      "Activate": "Policy integrity verification completed without errors."
    },
    "RETIRED": {
      "Default": "Expired policy retained for historical purposes.",
      "Removable": "Historical cleanup is complete and deletion permission is approved.",
      "Waiting": "Unresolved problems prevent policy removal."
    }
  },
  "automatic_recovery": {
    "from": {
      "status": "APPROVED",
      "substatus": "Application_Problems"
    },
    "to": {
      "status": "APPROVED",
      "substatus": "Default"
    },
    "condition": "The policy conflict has been resolved.",
    "automatic": true
  },
  "boundaries": {
    "catalog_status_schema": "EMPTY_NON_OWNING_SLOT",
    "implementation_authorization_is_independent": true,
    "existing_policy_record_bulk_rewrite": "CURRENT_REGISTERED_POLICY_FILES_EXCLUDING_LEGACY",
    "existing_validator_cutover": "GOV_CONTRACT_ADMITTED",
    "retired_removable_automatically_deletes_files": false,
    "draft_pass_automatic_promotion": "REMOVED",
    "policy_authority_ref": "developer/policy/approvals/MPA-20261013-LIFECYCLE-STAGE-DECOUPLING-KEEP-LATEST.yaml"
  },
  "$ref": "#/$defs/policy_fields",
  "resolution_authority": {
    "DRAFT": false,
    "APPROVED": true,
    "RETIRED": false
  }
}
