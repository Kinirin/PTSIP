{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-plan-bindings:v2",
  "title": "PTSIP Developer Policy-Plan Binding Registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "registry_role",
    "schema_ref",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-plan-bindings/v2"
    },
    "registry_role": {
      "const": "POLICY_PLAN_BINDING"
    },
    "schema_ref": {
      "const": "developer/bindings/schemas/policy-plan-bindings.schema.json"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "policy_ref",
        "planning_state"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^PPB-[0-9]{4,}$"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^MPD-(NORM|GOV|INTENT|ARCH|INFO|CNTR|RISK|SUPPLY|REAL|ASSURE|CTRL|CHANGE|OPS|RECORD)-[0-9]{4}$"
        },
        "planning_state": {
          "enum": [
            "NOT_CREATED",
            "CREATED"
          ]
        },
        "resolved_plan_id": {
          "type": "string",
          "pattern": "^PLN\\.[A-Z]{4}\\.[A-Z]{4}\\.[A-Za-z0-9]{8}$"
        },
        "plan_file_id": {
          "type": "string",
          "pattern": "^PLANFILE\\.[A-Z]{4}\\.[A-Za-z0-9]{12}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "plan_ref": {
          "type": "string",
          "pattern": "^developer/planning/.+\\.ya?ml$"
        },
        "policy_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "planning_state": {
                "const": "NOT_CREATED"
              }
            },
            "required": [
              "planning_state"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "resolved_plan_id"
                  ]
                },
                {
                  "required": [
                    "plan_file_id"
                  ]
                },
                {
                  "required": [
                    "version"
                  ]
                },
                {
                  "required": [
                    "revision"
                  ]
                },
                {
                  "required": [
                    "plan_ref"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "planning_state": {
                "const": "CREATED"
              }
            },
            "required": [
              "planning_state"
            ]
          },
          "then": {
            "required": [
              "resolved_plan_id",
              "plan_file_id",
              "version",
              "revision",
              "plan_ref"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
