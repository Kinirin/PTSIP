{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ptsip:policy-plan-bindings:v1",
  "title": "PTSIP Developer Policy-Plan Binding Registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "registry_role",
    "schema_ref",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "ptsip-policy-plan-bindings/v1"
    },
    "registry_role": {
      "const": "POLICY_PLAN_BINDING"
    },
    "schema_ref": {
      "const": "developer/bindings/schemas/policy-plan-bindings.schema.json"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "binding_id",
        "policy_ref",
        "planning_state"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^PPB-[0-9]{4,}$"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^MPD-[0-9]{4}$"
        },
        "planning_state": {
          "enum": ["NOT_CREATED", "CREATED"]
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "plan_ref": {
          "type": "string",
          "pattern": "^developer/planning/.+\\.ya?ml$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "planning_state": {
                "const": "NOT_CREATED"
              }
            },
            "required": ["planning_state"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["plan_id"]},
                {"required": ["plan_ref"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "planning_state": {
                "const": "CREATED"
              }
            },
            "required": ["planning_state"]
          },
          "then": {
            "required": ["plan_id", "plan_ref"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
